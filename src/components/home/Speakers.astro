---
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/';

const speakers = [
  {
    id: 1,
    name: "Dra. Liliana Cortés-Ortiz",
    title: "Presidenta de la Sociedad Internacional de Primatología",
    affiliation: "University of Michigan · Sociedad Internacional de Primatología",
    country: "México",
    flag: "🇲🇽",
    area: "Sistemática, evolución y conservación",
    bio: "Bióloga evolutiva y primatóloga mexicana, experta en sistemática y genética de conservación.",
    photo: `${base}images/speakers/liliana-cortez-ortiz.jpg`,
    initials: "LC",
    color: "#8C374E"
  },
  {
    id: 2,
    name: "Dr. Filippo Aureli",
    title: "Curso Pre-Congreso",
    affiliation: "Universidad Veracruzana / Instituto de Neuroetología",
    country: "México",
    flag: "🇲🇽",
    area: "Etología y socioecología de primates",
    bio: "Etólogo especializado en el comportamiento social y las dinámicas de fisión-fusión en primates.",
    photo: `${base}images/speakers/filippo-aureli.jpg?v=2`,
    initials: "FA",
    color: "#c9a84c"
  },
  {
    id: 3,
    name: "Dr. Gideon Erkenswick-Watsa",
    title: "Director Ejecutivo y Co-fundador",
    affiliation: "Field Projects International",
    country: "Estados Unidos",
    flag: "🇺🇸",
    area: "Ecología de enfermedades y genética",
    bio: "Científico y ecólogo de enfermedades, cofundador de Field Projects International.",
    photo: `${base}images/speakers/gideon-erkenswick.jpg`,
    initials: "GE",
    color: "#8b5e3c"
  },
  {
    id: 4,
    name: "Marco Antonio Arenas Aspilcueta",
    title: "Director de Gestión Sostenible del Patrimonio de Fauna Silvestre",
    affiliation: "SERFOR",
    country: "Perú",
    flag: "🇵🇪",
    area: "Gestión y regulación de fauna",
    bio: "Director de la Dirección de Gestión Sostenible del Patrimonio de Fauna Silvestre del SERFOR.",
    photo: `${base}images/speakers/marco-arenas.jpg?v=2`,
    initials: "MA",
    color: "#D99D55"
  },
  {
    id: 5,
    name: "Leandro Jerusalinsky",
    title: "Coordinador del Centro Nacional de Investigación y Conservación de Primates y Xenartros",
    affiliation: "ICMBio/MMA",
    country: "Brasil",
    flag: "🇧🇷",
    area: "Conservación de primates",
    bio: "Coordinador del Centro Nacional de Investigación y Conservación de Primates y Xenartros (CPB) y Vicepresidente del IUCN/SSC Primate Specialist Group. Se dedica a la conservación desde 1997.",
    photo: `${base}images/speakers/leandro-jerusalinsky.jpg`,
    initials: "LJ",
    color: "#c9a84c"
  },
  {
    id: 6,
    name: "Citlalli Morelos Juárez",
    title: "Directora de la Reserva Tesoro Escondido",
    affiliation: "Fundación Reserva Tesoro Escondido",
    country: "Ecuador",
    flag: "🇪🇨",
    area: "Ecología y conservación",
    bio: "Impulsora de programas de parabiólogas y protección del mono araña de cabeza marrón. Fellow del WINGS WorldQuest Women of Discovery Award y nominada al Indianapolis Prize.",
    photo: `${base}images/speakers/citlalli-morelos.jpg`,
    initials: "CM",
    color: "#8C374E"
  },
];
---

<section class="section speakers" id="ponentes">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">Expertos invitados</span>
      <h2 class="section-title">Ponentes Destacados</h2>
      <p class="section-subtitle">
        Líderes científicos de Latinoamérica y el mundo que compartirán su conocimiento en el III CPP 2026.
      </p>
    </div>

    <div class="speakers__grid">
      {speakers.map((speaker, i) => (
        <article class={`speaker-card reveal reveal-delay-${(i % 4) + 1}`} style={`--speaker-color: ${speaker.color};`}>
          <!-- Photo / Avatar -->
          <div class="speaker-card__photo">
            {speaker.photo ? (
              <img src={speaker.photo} alt={`Foto de ${speaker.name}`} loading="lazy" />
            ) : (
              <div class="speaker-card__initials" style={`background: linear-gradient(135deg, ${speaker.color}, ${speaker.color}99);`}>
                {speaker.initials}
              </div>
            )}
            <div class="speaker-card__flag" aria-label={speaker.country}>{speaker.flag}</div>
          </div>

          <!-- Info -->
          <div class="speaker-card__info">
            <div class="speaker-card__area">{speaker.area}</div>
            <h3 class="speaker-card__name">{speaker.name}</h3>
            <p class="speaker-card__title">{speaker.title}</p>
            <p class="speaker-card__affiliation">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              {speaker.affiliation}
            </p>
            <p class="speaker-card__bio">{speaker.bio}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="speakers__cta reveal">
      <p class="speakers__coming-soon">
        🔔 Se anunciarán más ponentes próximamente
      </p>
      <a href={`${base}ponentes`} class="btn btn-secondary">
        Ver todos los ponentes
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .speakers {
    background: var(--cream-warm);
  }

  :global([data-theme="dark"]) .speakers {
    background: linear-gradient(180deg, #0d2318 0%, #0a1f14 100%);
  }

  .speakers__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .speakers__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .speakers__grid { grid-template-columns: repeat(4, 1fr); }
  }

  /* ── Speaker Card ────────────────────────────────── */
  .speaker-card {
    background: rgba(255,255,255,0.9);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(217,157,85,0.12);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: all var(--transition-mid);
    display: flex;
    flex-direction: column;
  }

  :global([data-theme="dark"]) .speaker-card {
    background: rgba(26,58,46,0.55);
    border-color: rgba(217,157,85,0.18);
  }

  .speaker-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md), 0 0 30px color-mix(in srgb, var(--speaker-color) 15%, transparent);
    border-color: var(--speaker-color);
  }

  /* Photo */
  .speaker-card__photo {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(217,157,85,0.1), rgba(45,106,79,0.2));
  }

  .speaker-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .speaker-card__initials {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: rgba(255,255,255,0.9);
  }

  .speaker-card__flag {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    font-size: 1.5rem;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
  }

  /* Info */
  .speaker-card__info {
    padding: 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .speaker-card__area {
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--speaker-color);
    margin-bottom: 0.2rem;
  }

  .speaker-card__name {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-on-light);
    line-height: 1.3;
  }

  :global([data-theme="dark"]) .speaker-card__name { color: var(--text-on-dark); }

  .speaker-card__title {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .speaker-card__affiliation {
    font-size: 0.78rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.1rem;
  }

  .speaker-card__bio {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-top: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* CTA */
  .speakers__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .speakers__coming-soon {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--text-muted);
    padding: 0.6rem 1.25rem;
    background: rgba(217,157,85,0.08);
    border-radius: 100px;
    border: 1px solid rgba(217,157,85,0.2);
  }
</style>
