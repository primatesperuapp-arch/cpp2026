---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Welcome from '../components/home/Welcome.astro';
import ThematicAxis from '../components/home/ThematicAxis.astro';
import FeaturedSpeaker from '../components/home/FeaturedSpeaker.astro';
import ImportantDates from '../components/home/ImportantDates.astro';
import RegistrationSteps from '../components/home/RegistrationSteps.astro';
import Partners from '../components/home/Partners.astro';
import JoinAppHome from '../components/home/JoinAppHome.astro';
import site from '../data/site.json';

const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/';
---

<BaseLayout
  title="Inicio"
  description={site.meta.description}
>
  <Header />

  <main id="main-content">
    <Hero />
    <Welcome />
    <ThematicAxis />
    <FeaturedSpeaker />
    <ImportantDates />
    <RegistrationSteps />
    <Partners />
    <JoinAppHome />

    <!-- Final CTA Banner -->
    <section class="cta-banner">
      <div class="cta-banner__bg" aria-hidden="true"></div>
      <div class="container cta-banner__content">
        <div class="cta-banner__text">
          <h2 class="cta-banner__title">¿Listo para ser parte del CPP 2026?</h2>
          <p class="cta-banner__subtitle">
            Consulta los lineamientos de exposición, regístrate como asistente o conviértete en patrocinador. El futuro de los primates en Perú se construye juntos.
          </p>
        </div>
        <div class="cta-banner__actions">
          <a href={`${base}llamado-de-resumenes`} class="btn btn-primary btn-lg">
            Lineamientos de Exposición
          </a>
          <a href={`${base}inscripciones`} class="btn btn-gold btn-lg">
            Inscribirse Ahora
          </a>
          <a href={`${base}contacto`} class="btn btn-ghost btn-lg">
            Contactar
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Modal de Anuncio Importante -->
  <div id="announcement-modal" class="modal-overlay" aria-hidden="true" style="display: none;">
    <div class="modal-card card-glass">
      <button class="modal-close-btn" id="modal-close-x" aria-label="Cerrar anuncio">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="pointer-events: none;">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="modal-header">
        <span class="modal-badge">✨ PROGRAMA OFICIAL 2026</span>
        <h3 class="modal-title">¡Ya puedes explorar el programa del congreso!</h3>
      </div>

      <div class="modal-body">
        <div class="modal-course-callout">
          <span class="program-launch-mark" aria-hidden="true">🗓️</span>
          <span class="course-tag">¡PROGRAMA DISPONIBLE!</span>
          <h4>Planifica cada momento del III CPP 2026</h4>
          <p>
            Consulta la agenda completa por día, abre cada actividad y descubre sus horarios, participantes, moderación y afiliaciones institucionales.
          </p>
        </div>
        
        <div class="modal-features">
          <div class="modal-feature-item">
            <span class="feature-icon">4</span>
            <div>
              <strong>Días de congreso</strong>
              <span>Del 30 de julio al 2 de agosto, más una actividad precongreso.</span>
            </div>
          </div>
          <div class="modal-feature-item">
            <span class="feature-icon">7</span>
            <div>
              <strong>Ponencias magistrales</strong>
              <span>Conferencias de especialistas internacionales.</span>
            </div>
          </div>
          <div class="modal-feature-item">
            <span class="feature-icon">5</span>
            <div>
              <strong>Simposios detallados</strong>
              <span>Cada intervención con hora y afiliación.</span>
            </div>
          </div>
          <div class="modal-feature-item">
            <span class="feature-icon">67</span>
            <div>
              <strong>Presentaciones programadas</strong>
              <span>13 orales y 54 intervenciones en simposios.</span>
            </div>
          </div>
          <div class="modal-feature-item">
            <span class="feature-icon">17</span>
            <div>
              <strong>Pósteres aceptados</strong>
              <span>Códigos, ejes temáticos, autores y afiliaciones.</span>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <a href={`${base}programa`} class="btn btn-gold modal-program-btn" id="modal-action-btn">
          ✨ Explorar el programa completo →
        </a>
        <button class="btn btn-ghost" id="modal-close-btn" style="font-size: 0.9rem; padding: 0.6rem 1.2rem;">
          Cerrar
        </button>
      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>

<style>
  .cta-banner {
    position: relative;
    padding: 5rem 0;
    overflow: hidden;
    background: linear-gradient(135deg, #41240e 0%, #593414 50%, #4a2b11 100%);
  }

  .cta-banner__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 50%, rgba(217,157,85,0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 50%, rgba(140,55,78,0.06) 0%, transparent 40%);
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23D99D55' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
  }

  .cta-banner__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    text-align: center;
  }

  @media (min-width: 1024px) {
    .cta-banner__content {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .cta-banner__text { max-width: 580px; }

  .cta-banner__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    color: #fff;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .cta-banner__subtitle {
    font-size: 1rem;
    color: rgba(255,255,255,0.68);
    line-height: 1.7;
  }

  .cta-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .cta-banner__actions { justify-content: flex-start; }
  }

  /* ── Announcement Modal ─────────────────────────── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(18, 38, 30, 0.75);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.4s ease;
    overflow-y: auto; /* Enable vertical scroll if content is taller than viewport */
    -webkit-overflow-scrolling: touch;
  }
  .modal-overlay.active {
    opacity: 1;
  }

  .modal-card {
    position: relative;
    width: 100%;
    max-width: 540px;
    background: rgba(255, 255, 255, 0.98);
    border-radius: var(--radius-xl);
    border: 1.5px solid rgba(217, 157, 85, 0.35);
    padding: 2.5rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    transform: translateY(20px) scale(0.95);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    margin-top: 10vh; /* Pushes the card down from the top viewport boundary */
    margin-bottom: 10vh;
    margin-left: auto;
    margin-right: auto;
    flex-shrink: 0; /* Prevent flex box from shrinking the modal height */
    overflow: hidden;
  }
  .modal-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    background: linear-gradient(90deg, var(--forest-dark), var(--gold), var(--accent-secondary));
  }
  :global([data-theme="dark"]) .modal-card {
    background: rgba(26, 58, 46, 0.98);
    border-color: rgba(217, 157, 85, 0.25);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65);
  }
  .modal-overlay.active .modal-card {
    transform: translateY(0) scale(1);
  }

  .modal-close-btn {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(0, 0, 0, 0.05);
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
    z-index: 10;
  }
  .modal-close-btn:hover {
    background: rgba(0, 0, 0, 0.1);
    color: var(--text-on-light);
    transform: scale(1.05);
  }
  :global([data-theme="dark"]) .modal-close-btn {
    background: rgba(255, 255, 255, 0.08);
  }
  :global([data-theme="dark"]) .modal-close-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: var(--text-on-dark);
  }

  /* Responsive tweaks for short/narrow screens (high zoom) */
  @media (max-height: 640px), (max-width: 576px) {
    .modal-overlay {
      padding: 1rem;
    }
    .modal-card {
      padding: 1.75rem 1.25rem;
      border-radius: var(--radius-lg);
    }
    .modal-close-btn {
      top: 0.75rem;
      right: 0.75rem;
      width: 1.75rem;
      height: 1.75rem;
    }
    .modal-header {
      margin-bottom: 1rem;
    }
    .modal-body {
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .modal-footer {
      padding-top: 1rem;
    }
  }

  .modal-header {
    margin-bottom: 1.5rem;
  }
  .modal-badge {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--forest-dark);
    background: linear-gradient(90deg, rgba(217,157,85,0.16), rgba(191,38,79,0.1));
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    margin-bottom: 0.75rem;
    letter-spacing: 0.05em;
  }
  :global([data-theme="dark"]) .modal-badge {
    color: var(--gold-light);
    background: rgba(217, 157, 85, 0.15);
  }
  .modal-title {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2.05rem);
    color: var(--forest-darkest);
    line-height: 1.25;
    margin: 0;
  }
  :global([data-theme="dark"]) .modal-title {
    color: var(--forest-canopy);
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .modal-body p {
    font-size: 0.95rem;
    color: var(--text-on-light);
    line-height: 1.6;
    margin: 0;
  }
  :global([data-theme="dark"]) .modal-body p {
    color: var(--text-on-dark);
  }

  .modal-features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: 0.75rem;
    background: rgba(217, 157, 85, 0.06);
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(217, 157, 85, 0.15);
  }
  :global([data-theme="dark"]) .modal-features {
    background: rgba(217, 157, 85, 0.03);
  }

  .modal-course-callout {
    background: linear-gradient(135deg, rgba(89,52,20,0.98), rgba(140,55,78,0.96));
    border: 1.5px solid rgba(217,157,85,0.7);
    border-radius: var(--radius-lg);
    padding: 1.35rem 1.35rem 1.35rem 5rem;
    position: relative;
    box-shadow: var(--shadow-sm);
    text-align: left;
    overflow: hidden;
  }
  .program-launch-mark {
    position: absolute;
    left: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 2.85rem;
    height: 2.85rem;
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
    font-size: 1.35rem;
    box-shadow: 0 8px 22px rgba(0,0,0,0.18);
  }
  .modal-course-callout h4 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: #fff;
    margin: 0.5rem 0 0.35rem 0;
  }
  :global([data-theme="dark"]) .modal-course-callout h4 {
    color: var(--forest-canopy);
  }
  .modal-course-callout p {
    font-size: 0.88rem !important;
    line-height: 1.45 !important;
    color: rgba(255,255,255,0.82) !important;
    margin: 0 !important;
  }
  :global([data-theme="dark"]) .modal-course-callout p {
    color: var(--text-on-dark) !important;
  }
  .course-tag {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 900;
    color: var(--forest-darkest);
    background: var(--gold-light);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
    animation: pulse 1.8s infinite;
  }
  @keyframes pulse {
    0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(217, 157, 85, 0.4); }
    70% { transform: scale(1.03); box-shadow: 0 0 0 6px rgba(217, 157, 85, 0); }
    100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(217, 157, 85, 0); }
  }
  .modal-feature-item {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: 0.75rem 0.65rem;
    border: 1px solid rgba(217,157,85,0.15);
    border-radius: var(--radius-md);
    background: rgba(255,255,255,0.55);
    text-align: center;
  }
  .feature-icon {
    color: var(--accent-secondary);
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 900;
    line-height: 1;
  }
  .modal-feature-item strong {
    display: block;
    font-size: 0.9rem;
    color: var(--forest-mid);
    margin-bottom: 0.15rem;
  }
  :global([data-theme="dark"]) .modal-feature-item strong {
    color: var(--gold-light);
  }
  .modal-feature-item span {
    font-size: 0.83rem;
    color: var(--text-muted);
    line-height: 1.4;
    display: block;
    text-align: center;
  }

  .modal-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding-top: 1.5rem;
  }
  .modal-program-btn {
    flex: 1;
    justify-content: center;
    padding: 0.78rem 1.1rem;
    color: var(--forest-darkest);
    font-size: 0.9rem;
    font-weight: 900;
    box-shadow: 0 9px 22px rgba(217,157,85,0.24);
  }

  @media (max-width: 576px) {
    .modal-features { grid-template-columns: 1fr; }
    .modal-feature-item { grid-template-columns: auto 1fr; align-items: center; text-align: left; }
    .modal-feature-item span { text-align: left; }
    .modal-course-callout { padding: 4.3rem 1rem 1rem; }
    .program-launch-mark { top: 1rem; left: 1rem; transform: none; width: 2.5rem; height: 2.5rem; }
    .modal-footer { align-items: stretch; flex-direction: column; }
  }
  :global([data-theme="dark"]) .modal-footer {
    border-top-color: rgba(255, 255, 255, 0.08);
  }
</style>

<script>
  function setupAnnouncementModal() {
    const modal = document.getElementById('announcement-modal') as HTMLDivElement;
    if (!modal) return;

    // Show after 1 second delay for superior entry feel
    setTimeout(() => {
      modal.style.display = 'flex';
      // Trigger browser paint
      modal.offsetHeight;
      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
    }, 1000);

    const closeActions = [
      document.getElementById('modal-close-x'),
      document.getElementById('modal-close-btn'),
      document.getElementById('modal-action-btn')
    ];

    function closeModal() {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');

      // Wait for opacity transition to finish before display: none
      setTimeout(() => {
        modal.style.display = 'none';
      }, 400);
    }

    closeActions.forEach(btn => {
      if (btn) {
        btn.addEventListener('click', closeModal);
      }
    });

    // Close on click outside the card
    modal.addEventListener('click', (e) => {
      const card = modal.querySelector('.modal-card');
      if (card && !card.contains(e.target as Node)) {
        closeModal();
      }
    });
  }

  // Run on load
  setupAnnouncementModal();
  // Listen for Astro transitions page load
  document.addEventListener('astro:page-load', setupAnnouncementModal);
</script>
