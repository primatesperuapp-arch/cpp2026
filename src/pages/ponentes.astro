---
import PageLayout from '../layouts/PageLayout.astro';
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/';

const speakers = [
  { id: 1, name: "Rosamira Guillén Monroy", title: "Directora Ejecutiva", affiliation: "Fundación Proyecto Tití", country: "Colombia", flag: "🇨🇴", area: "Conservación de primates", bio: "Arquitecta paisajista y conservacionista con más de 25 años de experiencia en la protección del tití cabeciblanco. Lidera proyectos de restauración de ecosistemas y desarrollo comunitario en el Caribe colombiano. Ganadora del Whitley Award y el National Geographic Society/Buffett Award.", initials: "RG", color: "#8C374E", type: "Magistral", photo: `${base}images/speakers/rosamira-guillen.jpg` },
  { id: 2, name: "Dr. Filippo Aureli", title: "Curso Pre-Congreso", affiliation: "Universidad Veracruzana / Instituto de Neuroetología", country: "México", flag: "🇲🇽", area: "Etología y socioecología de primates", bio: "Etólogo con más de 40 años de experiencia estudiando el comportamiento social, manejo de conflictos y dinámicas de fisión-fusión en primates. Especialista en la conservación del mono araña en México y Centroamérica. Explorador de National Geographic y autor de más de 190 artículos científicos.", initials: "FA", color: "#593414", type: "Pre-Congreso", photo: `${base}images/speakers/filippo-aureli.jpg?v=2`},
  { id: 7, name: "Leandro Jerusalinsky", title: "Coordinador del CPB - ICMBio/MMA", affiliation: "Instituto Chico Mendes de Conservación de la Biodiversidad", country: "Brasil", flag: "🇧🇷", area: "Conservación de primates", bio: "Coordinador del Centro Nacional de Investigación y Conservación de Primates y Xenartros (CPB) del ICMBio/MMA y Vicepresidente del IUCN/SSC Primate Specialist Group. Se dedica a la conservación desde 1997 y fue galardonado con el IPS Special Presidential Award en 2022.", initials: "LJ", color: "#c9a84c", type: "Magistral", photo: `${base}images/speakers/leandro-jerusalinsky.jpg` },
  { id: 8, name: "Citlalli Morelos Juárez", title: "Directora de la Reserva Tesoro Escondido", affiliation: "Fundación Reserva Tesoro Escondido", country: "Ecuador", flag: "🇪🇨", area: "Ecología y conservación", bio: "Directora de la Reserva Tesoro Escondido. PhD por la Universidad de Sussex, especialista en la conservación del mono araña de cabeza marrón. Fellow del WINGS WorldQuest Women of Discovery Award (2022) y nominada oficial al Indianapolis Prize (2023) por su trabajo empoderando a mujeres locales a través de programas de parabiólogas en el Chocó ecuatoriano.", initials: "CM", color: "#8C374E", type: "Magistral", photo: `${base}images/speakers/citlalli-morelos.jpg?v=3` },
  { id: 9, name: "Dr. Gideon Erkenswick-Watsa", title: "Director Ejecutivo y Co-fundador", affiliation: "Field Projects International", country: "Estados Unidos", flag: "🇺🇸", area: "Ecología de enfermedades y genética", bio: "Científico, ecólogo de enfermedades y genetista de la conservación. Co-fundador de Field Projects International. Co-coordina la iniciativa 'In Situ Laboratory' en la Amazonía peruana, implementando laboratorios portátiles de diagnóstico molecular y secuenciación de ADN para el monitoreo de la salud de primates silvestres.", initials: "GE", color: "#2d6a4f", type: "Magistral", photo: `${base}images/speakers/gideon-erkenswick.jpg` },
  { id: 10, name: "Marco Antonio Arenas Aspilcueta", title: "Director de Gestión Sostenible del Patrimonio de Fauna Silvestre", affiliation: "SERFOR", country: "Perú", flag: "🇵🇪", area: "Gestión y regulación de fauna", bio: "Ingeniero agrónomo y magíster en Gestión de la Biodiversidad. Actualmente es Director de la Dirección de Gestión Sostenible del Patrimonio de Fauna Silvestre del SERFOR. Cuenta con amplia trayectoria en la gestión de Áreas Naturales Protegidas en el SERNANP y como Director General de Diversidad Biológica en el MINAM, liderando programas de conservación, co-gestión y mecanismos de retribución por servicios ecosistémicos.", initials: "MA", color: "#c9a84c", type: "Magistral", photo: `${base}images/speakers/marco-arenas.jpg?v=2` },
  { id: 11, name: "Dra. Liliana Cortés-Ortiz", title: "Presidenta de la Sociedad Internacional de Primatología", affiliation: "University of Michigan · Sociedad Internacional de Primatología", country: "México", flag: "🇲🇽", area: "Sistemática, evolución y conservación", bio: "Presidenta de la Sociedad Internacional de Primatología. Bióloga evolutiva y primatóloga mexicana, Profesora de Investigación en la Universidad de Michigan y Directora del Genomic Diversity Laboratory. Su investigación integra ecología y genética molecular para responder preguntas sobre filogenia, hibridación natural y conservación de primates neotropicales.", initials: "LC", color: "#8C374E", type: "Magistral", photo: `${base}images/speakers/liliana-cortez-ortiz.jpg` },
  { id: 12, name: "Mark Bowler", title: "Profesor e Investigador", affiliation: "University of Suffolk", country: "Reino Unido", flag: "🇬🇧", area: "Ecología, comportamiento y bioacústica", bio: "Primatólogo y ecólogo de la conservación con amplia experiencia en la Amazonía peruana y profesor en la Universidad de Suffolk. Su trabajo se centra en el impacto humano en las poblaciones de primates, la ecología y el monitoreo acústico. Lidera el '8 Primates Project', una iniciativa que utiliza bioacústica y que fue galardonada en los Regenerative Travel Impact Awards 2025.", initials: "MB", color: "#593414", type: "Magistral", photo: `${base}images/speakers/mark-bowler.jpg` },

  // Instituciones Invitadas
  { id: 13, name: "SERNANP", title: "Servicio Nacional de Áreas Naturales Protegidas por el Estado", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Áreas Naturales Protegidas", bio: "Organismo público adscrito al Ministerio del Ambiente, encargado de dirigir y establecer los criterios técnicos y administrativos para la conservación de las Áreas Naturales Protegidas del Perú.", photo: `${base}images/aliados/logo_SERNANP.png`, initials: "SN", color: "#2d6a4f", type: "Invitado" },
  { id: 14, name: "Reserva Comunal Airo Pai", title: "Área Natural Protegida - Loreto", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Conservación Comunitaria", bio: "Área protegida en la cuenca del río Putumayo que conserva la biodiversidad y promueve el manejo sostenible de recursos en cogestión con los pueblos indígenas Secoya (Airo Pai), Kichwa y Huitoto.", initials: "AP", color: "#8c5e3c", type: "Invitado" },
  { id: 15, name: "Reserva Comunal Purús", title: "Área Natural Protegida - Ucayali/Madre de Dios", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Conservación Comunitaria", bio: "Área natural de conservación que protege la cuenca del río Purús, salvaguardando la diversidad biológica y garantizando los territorios de los pueblos indígenas locales en cogestión participativa.", initials: "RP", color: "#c9a84c", type: "Invitado" },
  { id: 16, name: "Reserva Comunal Amarakaeri", title: "Área Natural Protegida - Madre de Dios", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Conservación Comunitaria", bio: "Modelo pionero de cogestión entre el Estado peruano (SERNANP) y el Ejecutor de Contrato de Administración de la Reserva Comunal Amarakaeri (ECA Amarakaeri), liderado por los pueblos Harakbut, Matsigenka y Yine.", initials: "RA", color: "#2d6a4f", type: "Invitado" },
  { id: 17, name: "Parque Nacional Sierra del Divisor", title: "Área Natural Protegida - Loreto/Ucayali", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Conservación in situ", bio: "Resguarda una de las formaciones geológicas más antiguas y singulares de la Amazonía peruana, albergando una diversidad excepcional de primates y especies endémicas en peligro de extinción.", initials: "SD", color: "#593414", type: "Invitado" },
  { id: 18, name: "Parque Nacional Cerros de Amotape", title: "Área Natural Protegida - Tumbes/Piura", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Conservación in situ", bio: "Conserva muestras únicas del Bosque Seco Ecuatorial y del Bosque Tropical del Pacífico, hábitat fundamental en el norte peruano para especies endémicas y amenazadas.", initials: "CA", color: "#8C374E", type: "Invitado" },
  { id: 19, name: "Bosque de Protección Alto Mayo", title: "Área Natural Protegida - San Martín", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Conservación y Recursos Hídricos", bio: "Protege las cuencas del río Mayo para asegurar el abastecimiento de agua y conservar el hábitat de especies endémicas críticas como el mono choro de cola amarilla y el mono tocón del Alto Mayo.", initials: "AM", color: "#c9a84c", type: "Invitado" },
  { id: 20, name: "SERFOR", title: "Servicio Nacional Forestal y de Fauna Silvestre", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Gestión y Regulación de Fauna", bio: "Autoridad nacional encargada de dictar normas, supervisar y promover el aprovechamiento sostenible y la conservación de los recursos forestales y de fauna silvestre del Perú.", photo: `${base}images/aliados/logo_serfor.png`, initials: "SF", color: "#8c5e3c", type: "Invitado" },
  { id: 21, name: "UPCH", title: "Universidad Peruana Cayetano Heredia", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Investigación y Academia", bio: "Institución académica líder en investigación científica, salud y ciencias biológicas en el Perú, con importantes proyectos dedicados al estudio de fauna, zoonosis y conservación ambiental.", initials: "CH", color: "#8C374E", type: "Invitado" },
  { id: 22, name: "EPP", title: "Equipo Primatológico del Perú", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Investigación y Educación Ambiental", bio: "Organización científica y educativa dedicada a promover la investigación, la conservación y la sensibilización sobre los primates en el Perú mediante talleres, cursos y proyectos de campo.", initials: "EP", color: "#2d6a4f", type: "Invitado" },
  { id: 23, name: "Yunkawasi", title: "Asociación Yunkawasi", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Conservación de Especies Amenazadas", bio: "Organización no gubernamental dedicada a la conservación de especies amenazadas y sus hábitats en el Perú, con especial énfasis en el mono choro de cola amarilla y el mono tocón andino.", photo: `${base}images/aliados/logo_yunkawasi.png`, initials: "YW", color: "#8c5e3c", type: "Invitado" },
  { id: 24, name: "Proyecto Mono Tocón", title: "Asociación Proyecto Mono Tocón", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Conservación de Especies y Bosques", bio: "Asociación dedicada a la conservación del mono tocón de San Martín (Plecturocebus oenanthe), especie críticamente amenazada, y la protección de su hábitat en los bosques secos y de neblina.", photo: `${base}images/aliados/logo_pmt.png`, initials: "MT", color: "#c9a84c", type: "Invitado" },
  { id: 25, name: "Field Projects International", title: "Organización de Investigación y Entrenamiento de Campo", affiliation: "Estados Unidos / Perú", country: "Perú", flag: "🇵🇪", area: "Investigación y Capacitación", bio: "Organización internacional sin fines de lucro enfocada en la investigación de la biodiversidad, la medicina silvestre y la capacitación de estudiantes mediante cursos inmersivos de campo en la Amazonía.", initials: "FP", color: "#593414", type: "Invitado" },
  { id: 26, name: "Wired Amazon", title: "Iniciativa de Ciencia Ciudadana y Ecoturismo", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Monitoreo e Innovación Tecnológica", bio: "Iniciativa tecnológica y de ecoturismo en Tambopata que integra la ciencia ciudadana con el monitoreo biológico de primates y otras especies emblemáticas del bosque lluvioso.", initials: "WA", color: "#8C374E", type: "Invitado" },
  { id: 27, name: "Estación Biológica Cocha Cashu", title: "Centro de Investigación de Ecología Tropical", affiliation: "San Diego Zoo Wildlife Alliance / SERNANP", country: "Perú", flag: "🇵🇪", area: "Ecología Tropical y Conservación", bio: "Estación científica de renombre mundial ubicada dentro del Parque Nacional del Manu, dedicada al estudio de la ecología de los bosques tropicales y el comportamiento de fauna silvestre.", initials: "CC", color: "#2d6a4f", type: "Invitado" },
  { id: 28, name: "Estación Biológica Kawsay", title: "Estación Científica y de Educación", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Monitoreo y Educación Científica", bio: "Centro de investigación y educación ambiental en Madre de Dios enfocado en cursos de campo, monitoreo biológico e investigación de primates en alianza con Field Projects International.", photo: `${base}images/aliados/logo-kawsay.png`, initials: "KB", color: "#c9a84c", type: "Invitado" },
  { id: 29, name: "Asociación de Conservación Oso Dorado", title: "Organización Comunitaria - Corosha", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Conservación Comunitaria", bio: "Asociación de base comunitaria en Amazonas que gestiona el Área de Conservación Privada Hierba Buena Allpayacu, protegiendo hábitats montanos y al mono choro de cola amarilla.", initials: "OD", color: "#D99D55", type: "Invitado" },
  { id: 30, name: "Rainforest Expeditions", title: "Organización de Ecoturismo y Conservación", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Ecoturismo y Citizen Science", bio: "Empresa de ecoturismo pionera en el Perú que promueve la conservación de la biodiversidad en Tambopata mediante proyectos de ciencia ciudadana e investigación aplicada.", initials: "RE", color: "#8c5e3c", type: "Invitado" },
  { id: 31, name: "Patronato del Parque de las Leyendas", title: "Zoológico, Botánico y Complejo Arqueológico", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Conservación ex situ", bio: "Institución líder en la conservación ex situ de fauna silvestre peruana, albergando importantes programas de manejo y reproducción en cautiverio de primates amenazados.", initials: "PL", color: "#c9a84c", type: "Invitado" },
  { id: 32, name: "Sociedad Zoológica de Fráncfort (SZF)", title: "Organización Internacional de Conservación", affiliation: "Perú", country: "Perú", flag: "🇵🇪", area: "Gestión de Áreas Protegidas", bio: "Organización dedicada a proteger la biodiversidad y ecosistemas silvestres en el sureste del Perú, apoyando el monitoreo biológico y la gestión de parques nacionales amazónicos.", initials: "ZF", color: "#2d6a4f", type: "Invitado" }
];
---

<PageLayout
  title="Ponentes e Instituciones"
  description="Conoce a los ponentes magistrales y las instituciones participantes del III Congreso Peruano de Primatología 2026: investigadores, áreas naturales protegidas y entidades líderes."
  heroTitle="Ponentes e Instituciones"
  heroSubtitle="Expertos e instituciones líderes del III CPP 2026"
  heroColor="var(--forest-dark)"
>
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Expertos confirmados</span>
        <h2 class="section-title">Ponentes del Congreso</h2>
        <p class="section-subtitle">
          Científicos y especialistas confirmados para construir el futuro de la primatología latinoamericana.
        </p>
      </div>

      <!-- Magistrales -->
      <h3 class="speakers-section-title reveal">🏆 Conferenciantes Magistrales</h3>
      <div class="speakers-main-grid">
        {speakers.filter(s => s.type === 'Magistral').map((s, i) => (
          <article class={`speaker-full-card reveal reveal-delay-${i+1}`} style={`--sc: ${s.color};`}>
            <div class="speaker-full-card__avatar">
              {s.photo ? (
                <img src={s.photo} alt={s.name} class="speaker-full-card__img" />
              ) : (
                <div class="speaker-full-card__initials" style={`background: linear-gradient(135deg, ${s.color}, ${s.color}80);`}>
                  {s.initials}
                </div>
              )}
            </div>
            <div class="speaker-full-card__info">
              <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.4rem;">
                <span class="badge badge-gold" style="font-size:0.7rem;">Conferencia Magistral</span>
                <span style="font-size:1.2rem;">{s.flag}</span>
              </div>
              <h3 class="speaker-full-card__name">{s.name}</h3>
              <p class="speaker-full-card__title">{s.title}</p>
              <p class="speaker-full-card__affiliation">
                <span>Afiliación</span>
                {s.affiliation}
              </p>
              <p class="speaker-full-card__area">{s.area}</p>
              <p class="speaker-full-card__bio">{s.bio}</p>
            </div>
          </article>
        ))}
      </div>

      <h3 class="speakers-section-title reveal" style="margin-top:3rem;">📚 Curso Pre-Congreso</h3>
      <div class="speakers-main-grid">
        {speakers.filter(s => s.type === 'Pre-Congreso').map((s, i) => (
          <article class={`speaker-full-card reveal reveal-delay-${i+1}`} style={`--sc: ${s.color};`}>
            <div class="speaker-full-card__avatar">
              {s.photo ? <img src={s.photo} alt={s.name} class="speaker-full-card__img" /> : <div class="speaker-full-card__initials" style={`background: linear-gradient(135deg, ${s.color}, ${s.color}80);`}>{s.initials}</div>}
            </div>
            <div class="speaker-full-card__info">
              <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.4rem;">
                <span class="badge badge-gold" style="font-size:0.7rem;">Curso Pre-Congreso</span>
                <span style="font-size:1.2rem;">{s.flag}</span>
              </div>
              <h3 class="speaker-full-card__name">{s.name}</h3>
              <p class="speaker-full-card__title">{s.title}</p>
              <p class="speaker-full-card__affiliation"><span>Afiliación</span>{s.affiliation}</p>
              <p class="speaker-full-card__area">{s.area}</p>
              <p class="speaker-full-card__bio">{s.bio}</p>
            </div>
          </article>
        ))}
      </div>

      <!-- Invitados -->
      <h3 class="speakers-section-title reveal" style="margin-top:3rem;">🏢 Instituciones Participantes e Invitadas</h3>
      <div class="speakers-grid">
        {speakers.filter(s => s.type === 'Invitado').map((s, i) => (
          <article class={`speaker-card-mini reveal reveal-delay-${(i%4)+1}`} style={`--sc: ${s.color};`}>
            <div class="speaker-card-mini__avatar">
              {s.photo ? (
                <img src={s.photo} alt={s.name} class="speaker-card-mini__img" />
              ) : (
                <div class="speaker-card-mini__initials" style={`background: linear-gradient(135deg, ${s.color}, ${s.color}80);`}>
                  {s.initials}
                </div>
              )}
            </div>
            <div class="speaker-card-mini__flag">{s.flag}</div>
            <div class="speaker-card-mini__area">{s.area}</div>
            <h3 class="speaker-card-mini__name">{s.name}</h3>
            <p class="speaker-card-mini__role">{s.title}</p>
            <p class="speaker-card-mini__affil">{s.affiliation}</p>
            <p class="speaker-card-mini__bio">{s.bio}</p>
          </article>
        ))}
      </div>


    </div>
  </section>
</PageLayout>

<style>
  .speakers-section-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--text-on-light);
    margin-bottom: 1.5rem;
  }
  :global([data-theme="dark"]) .speakers-section-title { color: var(--text-on-dark); }

  /* Main speakers (2 col) */
  .speakers-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }
  @media (min-width: 768px) { .speakers-main-grid { grid-template-columns: repeat(2, 1fr); } }

  .speaker-full-card {
    display: flex;
    gap: 1.5rem;
    padding: 1.75rem;
    background: rgba(255,255,255,0.9);
    border-radius: var(--radius-lg);
    border: 1.5px solid var(--sc);
    box-shadow: var(--shadow-md);
    align-items: flex-start;
    transition: transform var(--transition-mid);
  }
  :global([data-theme="dark"]) .speaker-full-card { background: rgba(26,58,46,0.6); }
  .speaker-full-card:hover { transform: translateY(-4px); }

  .speaker-full-card__avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .speaker-full-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .speaker-full-card__initials {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: rgba(255,255,255,0.9);
  }

  .speaker-full-card__info { flex: 1; }
  .speaker-full-card__name {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-on-light);
    margin-bottom: 0.2rem;
  }
  :global([data-theme="dark"]) .speaker-full-card__name { color: var(--text-on-dark); }
  .speaker-full-card__title { font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.45rem; }
  .speaker-full-card__affiliation {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    margin: 0 0 0.65rem;
    padding: 0.34rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--sc) 22%, transparent);
    border-radius: 0.5rem;
    color: var(--text-on-light);
    background: color-mix(in srgb, var(--sc) 8%, white);
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .speaker-full-card__affiliation span {
    color: var(--sc);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  :global([data-theme="dark"]) .speaker-full-card__affiliation {
    color: var(--text-on-dark);
    background: color-mix(in srgb, var(--sc) 16%, transparent);
  }
  .speaker-full-card__area {
    font-family: var(--font-ui); font-size: 0.72rem; font-weight: 700;
    color: var(--sc); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.75rem;
  }
  .speaker-full-card__bio { font-size: 0.85rem; color: var(--text-muted); line-height: 1.65; }

  /* Mini grid */
  .speakers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) { .speakers-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .speakers-grid { grid-template-columns: repeat(4, 1fr); } }

  .speaker-card-mini {
    position: relative;
    padding: 1.5rem 1.25rem;
    background: rgba(255,255,255,0.9);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(217,157,85,0.2);
    box-shadow: var(--shadow-sm);
    text-align: center;
    transition: all var(--transition-mid);
    display: flex;
    flex-direction: column;
    height: 100%;
    align-items: center;
  }
  :global([data-theme="dark"]) .speaker-card-mini { background: rgba(26,58,46,0.5); }
