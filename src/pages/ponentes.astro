---
import PageLayout from '../layouts/PageLayout.astro';
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/';

const speakers = [
  { id: 1, name: "Rosamira Guillén Monroy", title: "Directora Ejecutiva", affiliation: "Fundación Proyecto Tití", country: "Colombia", flag: "🇨🇴", area: "Conservación de primates", bio: "Arquitecta paisajista y conservacionista con más de 25 años de experiencia en la protección del tití cabeciblanco. Lidera proyectos de restauración de ecosistemas y desarrollo comunitario en el Caribe colombiano. Ganadora del Whitley Award y el National Geographic Society/Buffett Award.", initials: "RG", color: "#8C374E", type: "Magistral", photo: `${base}images/speakers/rosamira-guillen.jpg` },
  { id: 2, name: "Dr. Filippo Aureli", title: "Investigador Titular C", affiliation: "Universidad Veracruzana / Instituto de Neuroetología", country: "México", flag: "🇲🇽", area: "Etología y socioecología de primates", bio: "Etólogo con más de 40 años de experiencia estudiando el comportamiento social, manejo de conflictos y dinámicas de fisión-fusión en primates. Especialista en la conservación del mono araña en México y Centroamérica. Explorador de National Geographic y autor de más de 190 artículos científicos.", initials: "FA", color: "#593414", type: "Magistral", photo: `${base}images/speakers/filippo-aureli.jpg?v=2`},
  { id: 3, name: "Dr. Alejandro García-Naranjo", title: "Director de Conservación", affiliation: "Wildlife Conservation Society Perú", country: "Colombia", flag: "🇨🇴", area: "Conservación in situ", bio: "Lidera programas de conservación de primates amenazados en la cuenca del Orinoco y la Amazonía occidental. Pionero en el uso de cámaras trampa para el monitoreo de primates nocturnos.", initials: "AG", color: "#D99D55", type: "Invitado" },
  { id: 4, name: "Dra. Yamila Roca Pasca", title: "Investigadora Asociada", affiliation: "UNAM — México", country: "México", flag: "🇲🇽", area: "Etnoprimatología", bio: "Pionera en estudios de coexistencia humano-primate y conocimiento ecológico de comunidades indígenas amazónicas. Su trabajo integra metodologías de ciencias sociales y ecología para entender las relaciones culturales con los primates.", initials: "YR", color: "#8C374E", type: "Invitado" },
  { id: 5, name: "Dr. Pablo Stevenson", title: "Profesor", affiliation: "Universidad de los Andes", country: "Colombia", flag: "🇨🇴", area: "Comportamiento y dieta", bio: "Investigador líder en ecología de comunidades de primates y dispersión de semillas. Coordina el programa de monitoreo de primates a largo plazo en La Macarena, Colombia.", initials: "PS", color: "#D99D55", type: "Invitado" },
  { id: 6, name: "Dra. Gisella Orihuela", title: "Médico Veterinario Wildlife", affiliation: "SERNANP - Perú", country: "Perú", flag: "🇵🇪", area: "Medicina de fauna / One Health", bio: "Especialista en salud de fauna silvestre y zoonosis emergentes. Lidera el programa de vigilancia epidemiológica en primates de áreas naturales protegidas del Perú.", initials: "GO", color: "#8C374E", type: "Invitado" },
  { id: 7, name: "Leandro Jerusalinsky", title: "Coordinador del CPB - ICMBio/MMA", affiliation: "Instituto Chico Mendes de Conservación de la Biodiversidad", country: "Brasil", flag: "🇧🇷", area: "Conservación de primates", bio: "Coordinador del Centro Nacional de Investigación y Conservación de Primates y Xenartros (CPB) del ICMBio/MMA y Vicepresidente del IUCN/SSC Primate Specialist Group. Se dedica a la conservación desde 1997 y fue galardonado con el IPS Special Presidential Award en 2022.", initials: "LJ", color: "#c9a84c", type: "Magistral", photo: `${base}images/speakers/leandro-jerusalinsky.jpg` },
  { id: 8, name: "Citlalli Morelos Juárez", title: "Directora de la Reserva Tesoro Escondido", affiliation: "Fundación de Conservación Jocotoco", country: "Ecuador", flag: "🇪🇨", area: "Ecología y conservación", bio: "Directora de la Reserva Tesoro Escondido vinculada a la Fundación Jocotoco. PhD por la Universidad de Sussex, especialista en la conservación del mono araña de cabeza marrón. Fellow del WINGS WorldQuest Women of Discovery Award (2022) y nominada oficial al Indianapolis Prize (2023) por su trabajo empoderando a mujeres locales a través de programas de parabiólogas en el Chocó ecuatoriano.", initials: "CM", color: "#8C374E", type: "Magistral", photo: `${base}images/speakers/citlalli-morelos.jpg?v=3` },
  { id: 9, name: "Dr. Gideon Erkenswick-Watsa", title: "Director Ejecutivo y Co-fundador", affiliation: "Field Projects International", country: "Estados Unidos", flag: "🇺🇸", area: "Ecología de enfermedades y genética", bio: "Científico, ecólogo de enfermedades y genetista de la conservación. Co-fundador de Field Projects International. Co-coordina la iniciativa 'In Situ Laboratory' en la Amazonía peruana, implementando laboratorios portátiles de diagnóstico molecular y secuenciación de ADN para el monitoreo de la salud de primates silvestres.", initials: "GE", color: "#2d6a4f", type: "Magistral", photo: `${base}images/speakers/gideon-erkenswick.jpg` },
  { id: 10, name: "Marco Antonio Arenas Aspilcueta", title: "Especialista en Áreas Protegidas", affiliation: "SERNANP", country: "Perú", flag: "🇵🇪", area: "Gestión de áreas y biodiversidad", bio: "Especialista peruano en la gestión de Áreas Naturales Protegidas con amplia trayectoria en el SERNANP y el Ministerio del Ambiente. Ha liderado programas de conservación, gestión participativa y mecanismos de retribución por servicios ecosistémicos (MERESE). Promueve la investigación científica aplicada.", initials: "MA", color: "#c9a84c", type: "Magistral", photo: `${base}images/speakers/marco-arenas.jpg` },
  { id: 11, name: "Dra. Liliana Cortés-Ortiz", title: "Profesora de Investigación y Directora del GDL", affiliation: "Universidad de Michigan", country: "México", flag: "🇲🇽", area: "Sistemática, evolución y conservación", bio: "Bióloga evolutiva y primatóloga mexicana. Profesora de Investigación en la Universidad de Michigan y Directora del Genomic Diversity Laboratory. Su investigación integra ecología y genética molecular para responder preguntas sobre filogenia, hibridación natural y conservación de primates neotropicales.", initials: "LC", color: "#8C374E", type: "Magistral", photo: `${base}images/speakers/liliana-cortez-ortiz.jpg` },
  { id: 12, name: "Dr. Mark Bowler", title: "Profesor e Investigador", affiliation: "University of Suffolk / San Diego Zoo Wildlife Alliance", country: "Reino Unido", flag: "🇬🇧", area: "Ecología, comportamiento y bioacústica", bio: "Primatólogo y ecólogo de la conservación con amplia experiencia en la Amazonía peruana. Profesor en la Universidad de Suffolk. Su trabajo se centra en el impacto humano en poblaciones de primates, la ecología de sakis y uacaris, y la etnoprimatología. Lidera el '8 Primates Project' usando bioacústica.", initials: "MB", color: "#593414", type: "Magistral", photo: `${base}images/speakers/mark-bowler.jpg` }
];
---

<PageLayout
  title="Ponentes"
  description="Conoce a los ponentes magistrales e invitados del III Congreso Peruano de Primatología 2026: investigadores y conservacionistas líderes de Latinoamérica y el mundo."
  heroTitle="Ponentes"
  heroSubtitle="Investigadores y conservacionistas líderes del III CPP 2026"
  heroColor="var(--forest-dark)"
>
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Expertos confirmados</span>
        <h2 class="section-title">Ponentes del Congreso</h2>
        <p class="section-subtitle">
          Científicos de clase mundial reunidos en Lima para construir el futuro de la primatología latinoamericana. 
          <strong>¡Más anuncios de ponentes magistrales en camino!</strong>
        </p>
      </div>

      <!-- Magistrales -->
      <h3 class="speakers-section-title reveal">🏆 Conferenciantes Magistrales</h3>
      <div class="speakers-main-grid">
        {speakers.filter(s => s.type === 'Magistral').map((s, i) => (
          <article class={`speaker-full-card reveal reveal-delay-${i+1}`} style={`--sc: ${s.color};`}>
            <div class="speaker-full-card__avatar">
              {s.photo ? (
                <img src={s.photo} alt={s.name} class="speaker-full-card__img" />
              ) : (
                <div class="speaker-full-card__initials" style={`background: linear-gradient(135deg, ${s.color}, ${s.color}80);`}>
                  {s.initials}
                </div>
              )}
            </div>
            <div class="speaker-full-card__info">
              <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.4rem;">
                <span class="badge badge-gold" style="font-size:0.7rem;">Conferencia Magistral</span>
                <span style="font-size:1.2rem;">{s.flag}</span>
              </div>
              <h3 class="speaker-full-card__name">{s.name}</h3>
              <p class="speaker-full-card__title">{s.title} · {s.affiliation}</p>
              <p class="speaker-full-card__area">{s.area}</p>
              <p class="speaker-full-card__bio">{s.bio}</p>
            </div>
          </article>
        ))}
      </div>

      <!-- Invitados -->
      <h3 class="speakers-section-title reveal" style="margin-top:3rem;">🎤 Ponentes Invitados</h3>
      <div class="speakers-grid">
        {speakers.filter(s => s.type === 'Invitado').map((s, i) => (
          <article class={`speaker-card-mini reveal reveal-delay-${(i%4)+1}`} style={`--sc: ${s.color};`}>
            <div class="speaker-card-mini__avatar">
              {s.photo ? (
                <img src={s.photo} alt={s.name} class="speaker-card-mini__img" />
              ) : (
                <div class="speaker-card-mini__initials" style={`background: linear-gradient(135deg, ${s.color}, ${s.color}80);`}>
                  {s.initials}
                </div>
              )}
            </div>
            <div class="speaker-card-mini__flag">{s.flag}</div>
            <div class="speaker-card-mini__area">{s.area}</div>
            <h3 class="speaker-card-mini__name">{s.name}</h3>
            <p class="speaker-card-mini__role">{s.title}</p>
            <p class="speaker-card-mini__affil">{s.affiliation}</p>
            <p class="speaker-card-mini__bio">{s.bio}</p>
          </article>
        ))}
      </div>

      <!-- Coming soon -->
      <div class="reveal" style="text-align:center; margin-top:3rem; padding:2.5rem; border:1.5px dashed rgba(217,157,85,0.4); border-radius:var(--radius-lg);">
        <div style="font-size:2.5rem; margin-bottom:0.75rem;">🔔</div>
        <h3 style="font-family:var(--font-display); font-size:1.3rem; color:var(--forest-mid); margin-bottom:0.5rem;">Más ponentes en camino</h3>
        <p style="font-size:0.9rem; color:var(--text-muted); max-width:400px; margin:0 auto 1.5rem;">
          El comité científico continúa confirmando ponentes nacionales e internacionales. Suscríbete a nuestras noticias para no perderte los anuncios.
        </p>
        <a href={`${base}noticias`} class="btn btn-secondary">Ver novedades →</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .speakers-section-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--text-on-light);
    margin-bottom: 1.5rem;
  }
  :global([data-theme="dark"]) .speakers-section-title { color: var(--text-on-dark); }

  /* Main speakers (2 col) */
  .speakers-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }
  @media (min-width: 768px) { .speakers-main-grid { grid-template-columns: repeat(2, 1fr); } }

  .speaker-full-card {
    display: flex;
    gap: 1.5rem;
    padding: 1.75rem;
    background: rgba(255,255,255,0.9);
    border-radius: var(--radius-lg);
    border: 1.5px solid var(--sc);
    box-shadow: var(--shadow-md);
    align-items: flex-start;
    transition: transform var(--transition-mid);
  }
  :global([data-theme="dark"]) .speaker-full-card { background: rgba(26,58,46,0.6); }
  .speaker-full-card:hover { transform: translateY(-4px); }

  .speaker-full-card__avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .speaker-full-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .speaker-full-card__initials {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: rgba(255,255,255,0.9);
  }

  .speaker-full-card__info { flex: 1; }
  .speaker-full-card__name {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-on-light);
    margin-bottom: 0.2rem;
  }
  :global([data-theme="dark"]) .speaker-full-card__name { color: var(--text-on-dark); }
  .speaker-full-card__title { font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.3rem; }
  .speaker-full-card__area {
    font-family: var(--font-ui); font-size: 0.72rem; font-weight: 700;
    color: var(--sc); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.75rem;
  }
  .speaker-full-card__bio { font-size: 0.85rem; color: var(--text-muted); line-height: 1.65; }

  /* Mini grid */
  .speakers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) { .speakers-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .speakers-grid { grid-template-columns: repeat(4, 1fr); } }

  .speaker-card-mini {
    position: relative;
    padding: 1.5rem 1.25rem;
    background: rgba(255,255,255,0.9);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(217,157,85,0.2);
    box-shadow: var(--shadow-sm);
    text-align: center;
    transition: all var(--transition-mid);
    display: flex;
    flex-direction: column;
    height: 100%;
    align-items: center;
  }
  :global([data-theme="dark"]) .speaker-card-mini { background: rgba(26,58,46,0.5); }
  .speaker-card-mini:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); border-color: var(--sc); }

  .speaker-card-mini__avatar {
    width: 80px; height: 80px;
    border-radius: 50%;
    overflow: hidden;
    margin: 0 auto 0.75rem;
  }

  .speaker-card-mini__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .speaker-card-mini__initials {
    width: 100%;
    height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-size: 1.5rem; font-weight: 700;
    color: rgba(255,255,255,0.9);
  }

  .speaker-card-mini__flag { font-size: 1.5rem; margin-bottom: 0.25rem; }
  .speaker-card-mini__area {
    font-family: var(--font-ui); font-size: 0.65rem; font-weight: 700;
    color: var(--sc); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.4rem;
  }
  .speaker-card-mini__name { font-weight: 700; font-size: 0.9rem; color: var(--text-on-light); margin-bottom: 0.2rem; }
  :global([data-theme="dark"]) .speaker-card-mini__name { color: var(--text-on-dark); }
  .speaker-card-mini__role { font-size: 0.75rem; color: var(--text-muted); font-style: italic; }
  .speaker-card-mini__affil { font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.5rem; }
  .speaker-card-mini__bio {
    font-size: 0.78rem; color: var(--text-muted); line-height: 1.55;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    margin-top: auto;
    padding-top: 0.5rem;
  }
</style>
