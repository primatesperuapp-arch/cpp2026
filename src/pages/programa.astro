const typeConfig: Record<string, { color: string; label: string; icon: string }> = {
  conferencia:   { color: '#8C374E', label: 'Conferencia Magistral', icon: '🎤' },
  simposio:      { color: '#D99D55', label: 'Simposio', icon: '🗣️' },
  ponencias:     { color: '#c9a84c', label: 'Ponencias Orales', icon: '📢' },
  posters:       { color: '#8b5e3c', label: 'Sesión de Pósters', icon: '📌' },
  taller:        { color: '#74c69d', label: 'Taller / Reunión', icon: '🔬' },
  mesa_redonda:  { color: '#e07b54', label: 'Mesa Redonda', icon: '🔵' },
  apertura:      { color: '#c9a84c', label: 'Apertura', icon: '🏛️' },
  clausura:      { color: '#c9a84c', label: 'Clausura', icon: '🏆' },
  break:         { color: '#aaa', label: 'Descanso', icon: '☕' },
  social:        { color: '#74c69d', label: 'Actividad Social', icon: '🌿' },
  inscripcion:   { color: '#aaa', label: 'Registro', icon: '📋' },
  curso:         { color: '#52B788', label: 'Curso Pre/Post-Congreso', icon: '📖' },
};
---

<PageLayout
  title="Programa"
  description="Programa completo del III Congreso Peruano de Primatología 2026: conferencias magistrales, simposios, talleres, ponencias y sesiones de pósters."
  heroTitle="Programa"
  heroSubtitle="Agenda científica del III Congreso Peruano de Primatología 2026"
  heroColor="var(--earth-dark)"
>
  <!-- Nota -->
  <section class="section" style="padding-bottom: 2rem;">
    <div class="container">
      <div class="program-note reveal">
        <div class="program-note__icon">📌</div>
        <div class="program-note__text">
          <strong>Nota:</strong> Este cronograma presenta la propuesta y distribución de bloques del programa científico del III Congreso Peruano de Primatología 2026. Los detalles específicos y horarios exactos de cada ponencia individual serán publicados próximamente.
        </div>
      </div>

      <!-- Leyenda -->
      <div class="legend reveal">
        {Object.entries(typeConfig).filter(([k]) => !['inscripcion','break','apertura','clausura'].includes(k)).map(([, v]) => (
          <span class="legend-item" style={`--lc: ${v.color};`}>
            {v.icon} {v.label}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Programa por día con tabs -->
  <section class="section" style="background: var(--cream-warm); padding-top: 2rem;">
    <div class="container">
      
      <!-- Filtro Interactivo -->
      <div class="program-filters reveal">
        <span class="filter-label">Filtrar por:</span>
        <div class="filter-buttons">
          <button class="filter-btn active" data-filter="all">✨ Todos</button>
          <button class="filter-btn" data-filter="conferencia">🎤 Magistrales</button>
          <button class="filter-btn" data-filter="simposio">🗣️ Simposios</button>
          <button class="filter-btn" data-filter="ponencias">📢 Orales</button>
          <button class="filter-btn" data-filter="curso">📖 Cursos</button>
          <button class="filter-btn" data-filter="taller">🔬 Talleres</button>
        </div>
      </div>

      <div class="program-tabs" id="program-tabs">
        {Object.entries(schedule).map(([day, data], i) => (
          <button
            class={`program-tab ${i === 0 ? 'active' : ''}`}
            data-tab={day}
            id={`tab-${day.replace(' ','')}`}
            aria-controls={`panel-${day.replace(' ','')}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            role="tab"
          >
            <span class="program-tab__day">{day}</span>
            <span class="program-tab__theme">{data.theme}</span>
          </button>
        ))}
      </div>

      {Object.entries(schedule).map(([day, data], i) => (
        <div
          class={`program-panel ${i === 0 ? 'active' : ''}`}
          id={`panel-${day.replace(' ','')}`}
          role="tabpanel"
          aria-labelledby={`tab-${day.replace(' ','')}`}
        >
          <div class="program-header-day">
            <h2 class="program-header-day__title">{data.date}</h2>
            <p class="program-header-day__theme">Eje central: {data.theme}</p>
          </div>

          <div class="schedule-list">
            {data.sessions.map(session => {
              const cfg = typeConfig[session.type] || typeConfig.ponencias;
              const isBreak = session.type === 'break' || session.type === 'inscripcion';
              return (
                <div 
                  class={`schedule-item schedule-item--${session.type} ${isBreak ? 'schedule-item--is-break' : ''} fade-in-up`} 
                  data-type={session.type} 
                  style={`--s-color: ${cfg.color};`}
                >
                  <div class="schedule-item__time">
                    <span class="schedule-item__hour">{session.time}</span>
                    <span class="schedule-item__dur">{session.duration}</span>
                  </div>
                  <div class="schedule-item__bar" aria-hidden="true"></div>
                  
                  {isBreak ? (
                    <div class="schedule-item__break-card">
                      <span class="break-icon">{cfg.icon}</span>
                      <div>
                        <span class="break-title">{session.title}</span>
                        {session.location && <span class="break-location"> — 📍 {session.location}</span>}
                      </div>
                    </div>
                  ) : (
                    <div class="schedule-item__card">
                      <div class="schedule-item__card-header">
                        <div class="schedule-item__type-badge" style={`color: ${cfg.color}; background: ${cfg.color}12; border-color: ${cfg.color}25;`}>
                          {cfg.icon} {cfg.label}
                        </div>
                        {session.location && <span class="schedule-item__location-badge">📍 {session.location}</span>}
                      </div>
                      <h3 class="schedule-item__title">{session.title}</h3>
                      {session.speaker && (
                        <p class="schedule-item__speaker">
                          <span class="speaker-icon">👤</span> 
                          <span>{session.speaker}</span>
                        </p>
                      )}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>
</PageLayout>

<script>
  const tabs = document.querySelectorAll('.program-tab');
  const panels = document.querySelectorAll('.program-panel');
  const filterBtns = document.querySelectorAll('.filter-btn');

  // Handle Tabs Switch
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = (tab as HTMLElement).dataset.tab;
      tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      panels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      const targetPanel = document.getElementById(`panel-${target?.replace(' ','')}`);
      if (targetPanel) {
        targetPanel.classList.add('active');
      }
      
      // Reset filter button to 'Todos' upon switching day tabs
      resetFilters();
    });
  });

  // Handle Category Filters
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      filterSessions(filter || 'all');
    });
  });

  function resetFilters() {
    filterBtns.forEach(b => b.classList.remove('active'));
    const allBtn = document.querySelector('.filter-btn[data-filter="all"]');
    if (allBtn) allBtn.classList.add('active');
    filterSessions('all');
  }

  function filterSessions(filter: string) {
    const activePanel = document.querySelector('.program-panel.active');
    if (!activePanel) return;

    const items = activePanel.querySelectorAll('.schedule-item');
    items.forEach((item, index) => {
      const itemEl = item as HTMLElement;
      const type = itemEl.dataset.type;

      // Reset animation
      itemEl.style.animation = 'none';
      // Force reflow to restart animation
      void itemEl.offsetWidth;

      if (filter === 'all') {
        itemEl.style.display = '';
        itemEl.style.animation = `fadeInUp 0.3s ease forwards ${index * 0.03}s`;
      } else {
        if (type === filter) {
          itemEl.style.display = '';
          itemEl.style.animation = 'fadeInUp 0.3s ease forwards';
        } else {
          itemEl.style.display = 'none';
        }
      }
    });
  }
</script>

<style>
  .program-note {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: rgba(201,168,76,0.08);
    border: 1px solid rgba(201,168,76,0.25);
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
  }
  .program-note__icon { font-size: 1.5rem; }
  .program-note__text { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; }
  .program-note__text strong { color: var(--gold); }

  /* Legend */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .legend-item {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--lc) 10%, transparent);
    color: var(--lc);
    border: 1px solid color-mix(in srgb, var(--lc) 25%, transparent);
  }

  /* Filters */
  .program-filters {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    background: white;
    padding: 0.75rem 1.5rem;
    border-radius: 100px;
    border: 1px solid rgba(217,157,85,0.12);
    box-shadow: var(--shadow-sm);
  }
  :global([data-theme="dark"]) .program-filters {
    background: var(--forest-dark);
    border-color: rgba(217,157,85,0.18);
  }
  .filter-label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .filter-buttons {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .filter-btn {
    border: 1px solid rgba(0,0,0,0.04);
    background: rgba(0,0,0,0.02);
    padding: 0.35rem 0.9rem;
    border-radius: 100px;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  :global([data-theme="dark"]) .filter-btn {
    border-color: rgba(255,255,255,0.04);
    background: rgba(255,255,255,0.02);
  }
  .filter-btn:hover {
    background: rgba(217,157,85,0.08);
    color: var(--forest-leaf);
  }
  .filter-btn.active {
    background: var(--forest-leaf);
    border-color: var(--forest-leaf);
    color: white;
    box-shadow: 0 4px 10px rgba(44, 95, 76, 0.25);
  }

  /* Tabs */
  .program-tabs {
    display: flex;
    gap: 0.35rem;
    padding: 1rem 0 0;
    flex-wrap: wrap;
    border-bottom: 2px solid rgba(217,157,85,0.15);
  }

  .program-tab {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1.25rem;
    background: rgba(255,255,255,0.55);
    border: 1px solid rgba(217,157,85,0.12);
    border-bottom: none;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    cursor: pointer;
    transition: all var(--transition-fast);
    font-family: var(--font-body);
    text-align: left;
    margin-bottom: -2px;
  }
  :global([data-theme="dark"]) .program-tab {
    background: rgba(26,58,46,0.3);
    border-color: rgba(217,157,85,0.15);
    border-bottom: none;
  }

  .program-tab:hover { background: rgba(217,157,85,0.08); }
  .program-tab.active {
    background: white;
    border-color: rgba(217,157,85,0.18);
    border-top: 3px solid var(--forest-leaf);
    border-bottom: 2px solid white;
    z-index: 2;
  }
  :global([data-theme="dark"]) .program-tab.active {
    background: var(--forest-dark);
    border-color: rgba(217,157,85,0.2);
    border-top-color: var(--forest-leaf);
    border-bottom: 2px solid var(--forest-dark);
  }

  .program-tab__day { font-weight: 700; font-size: 0.88rem; color: var(--forest-mid); }
  :global([data-theme="dark"]) .program-tab__day { color: var(--forest-canopy); }
  .program-tab__theme { font-size: 0.68rem; color: var(--text-muted); margin-top: 0.15rem; max-width: 140px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Panel */
  .program-panel { display: none; }
  .program-panel.active { display: block; }

  .program-header-day {
