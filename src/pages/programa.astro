<script>
  const tabs = document.querySelectorAll('.program-tab');
  const panels = document.querySelectorAll('.program-panel');
  const filterBtns = document.querySelectorAll('.filter-btn');
  const calendarDays = document.querySelectorAll('.calendar-day');
  const calendarJumps = document.querySelectorAll('.calendar-jump');

  calendarJumps.forEach(jump => {
    jump.addEventListener('click', () => {
      const target = (jump as HTMLElement).dataset.calendarTarget;
      const matchingTab = document.querySelector(`.program-tab[data-tab="${target}"]`) as HTMLButtonElement | null;
      matchingTab?.click();
      document.querySelector('#program-tabs')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // Handle Tabs Switch
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = (tab as HTMLElement).dataset.tab;
      tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      panels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      calendarDays.forEach(day => {
        day.classList.toggle('active', (day as HTMLElement).dataset.calendarTarget === target);
      });
      const targetPanel = document.getElementById(`panel-${target?.replace(' ','')}`);
      if (targetPanel) {
        targetPanel.classList.add('active');
      }
      
      // Reset filter button to 'Todos' upon switching day tabs
      resetFilters();
    });
  });

  // Handle Category Filters
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      filterSessions(filter || 'all');
    });
  });

  function resetFilters() {
    filterBtns.forEach(b => b.classList.remove('active'));
    const allBtn = document.querySelector('.filter-btn[data-filter="all"]');
    if (allBtn) allBtn.classList.add('active');
    filterSessions('all');
  }

  function filterSessions(filter: string) {
    const activePanel = document.querySelector('.program-panel.active');
    if (!activePanel) return;

    const items = activePanel.querySelectorAll('.schedule-item');
    items.forEach((item, index) => {
      const itemEl = item as HTMLElement;
      const type = itemEl.dataset.type;

      // Reset animation
      itemEl.style.animation = 'none';
      // Force reflow to restart animation
      void itemEl.offsetWidth;

      if (filter === 'all') {
        itemEl.style.display = '';
        itemEl.style.animation = `fadeInUp 0.3s ease forwards ${index * 0.03}s`;
      } else {
        if (type === filter) {
          itemEl.style.display = '';
          itemEl.style.animation = 'fadeInUp 0.3s ease forwards';
        } else {
          itemEl.style.display = 'none';
        }
      }
    });
  }
</script>

