const escapeHtml = (text: string) => text
  .replaceAll('&', '&amp;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;')
  .replaceAll('"', '&quot;')
  .replaceAll("'", '&#039;');

const formatScientificNames = (text: string) => {
  let formatted = escapeHtml(text);
  scientificTaxa.forEach(([taxon], index) => {
    formatted = formatted.replaceAll(taxon, `%%TAXON_${index}%%`);
  });
  scientificTaxa.forEach(([, markup], index) => {
    formatted = formatted.replaceAll(`%%TAXON_${index}%%`, markup);
  });
  return formatted;
};

