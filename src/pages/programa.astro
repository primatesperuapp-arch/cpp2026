  }

  .program-tab:hover { background: rgba(217,157,85,0.08); }
  .program-tab.active {
    background: white;
    border-color: rgba(217,157,85,0.18);
    border-top: 3px solid var(--forest-leaf);
    border-bottom: 2px solid white;
    z-index: 2;
  }
  :global([data-theme="dark"]) .program-tab.active {
    background: var(--forest-dark);
    border-color: rgba(217,157,85,0.2);
    border-top-color: var(--forest-leaf);
    border-bottom: 2px solid var(--forest-dark);
  }

  .program-tab__day { font-weight: 700; font-size: 0.88rem; color: var(--forest-mid); }
  :global([data-theme="dark"]) .program-tab__day { color: var(--forest-canopy); }
  .program-tab__theme { font-size: 0.68rem; color: var(--text-muted); margin-top: 0.15rem; max-width: 140px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Panel */
  .program-panel { display: none; }
  .program-panel.active { display: block; }

  .program-header-day {
    padding: 1.25rem 1.5rem;
    background: white;
    border: 1px solid rgba(217,157,85,0.12);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    border-top: none;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  :global([data-theme="dark"]) .program-header-day {
    background: var(--forest-dark);
    border-color: rgba(217,157,85,0.18);
    border-top: none;
  }
  .program-header-day__title { font-family: var(--font-display); font-size: 1.25rem; color: var(--text-on-light); }
  :global([data-theme="dark"]) .program-header-day__title { color: var(--text-on-dark); }
  .program-header-day__theme { font-size: 0.85rem; color: var(--forest-leaf); margin-top: 0.25rem; font-weight: 600; }

  /* Schedule Timeline */
  .schedule-list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .schedule-item {
    display: grid;
    grid-template-columns: 85px 16px 1fr;
    gap: 1.25rem;
    align-items: stretch;
    opacity: 0;
    transform: translateY(12px);
  }

  .schedule-item__time {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-start;
    padding-top: 0.75rem;
  }
  .schedule-item__hour {
    font-family: var(--font-ui);
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--forest-mid);
    line-height: 1.1;
  }
  :global([data-theme="dark"]) .schedule-item__hour {
    color: var(--forest-canopy);
  }
  .schedule-item__dur {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  .schedule-item__bar {
    position: relative;
    width: 2px;
    background: rgba(217,157,85,0.15);
    margin: 0 auto;
  }
  :global([data-theme="dark"]) .schedule-item__bar {
    background: rgba(255,255,255,0.08);
  }
  .schedule-item__bar::after {
    content: '';
    position: absolute;
    top: 1.25rem;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--s-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--s-color) 20%, transparent);
    z-index: 1;
  }

  /* Card Styles */
  .schedule-item__card {
    background: white;
    border: 1px solid rgba(217,157,85,0.1);
    border-left: 4px solid var(--s-color);
    border-radius: var(--radius-md);
    padding: 1.2rem 1.5rem;
    box-shadow: var(--shadow-sm);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  :global([data-theme="dark"]) .schedule-item__card {
    background: var(--forest-dark);
    border-color: rgba(217,157,85,0.18);
    border-left-color: var(--s-color);
  }
  .schedule-item__card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--s-color) 35%, rgba(217,157,85,0.1));
  }

  .schedule-item__card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .schedule-item__type-badge {
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
    border: 1px solid;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .schedule-item__location-badge {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    background: rgba(0,0,0,0.03);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }
  :global([data-theme="dark"]) .schedule-item__location-badge {
    background: rgba(255,255,255,0.03);
  }

  .schedule-item__title {
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--text-on-light);
    line-height: 1.38;
  }
  :global([data-theme="dark"]) .schedule-item__title {
    color: var(--text-on-dark);
  }

  .schedule-item__speaker {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
    border-top: 1px dashed rgba(217,157,85,0.12);
    padding-top: 0.5rem;
  }

  .schedule-item__moderator {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.55rem 0 0;
    padding: 0.48rem 0.65rem;
    border-radius: 0.45rem;
    background: rgba(82, 183, 136, 0.1);
    color: var(--forest-mid);
    font-size: 0.8rem;
    line-height: 1.4;
  }
  :global([data-theme="dark"]) .schedule-item__moderator {
    background: rgba(116, 198, 157, 0.1);
    color: var(--forest-canopy);
  }

  .symposium-details {
    margin-top: 1rem;
    border-top: 1px solid rgba(217,157,85,0.22);
    padding-top: 0.8rem;
  }
  .symposium-details summary {
    cursor: pointer;
    color: var(--forest-mid);
    font-weight: 800;
    font-size: 0.84rem;
  }
  .symposium-details ol {
    margin: 0.8rem 0 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.6rem;
  }
  .symposium-details li {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 0.45rem;
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.45;
    padding-left: 0.15rem;
  }
  .symposium-details__time {
    color: var(--forest-leaf);
    font-weight: 800;
    white-space: nowrap;
  }
  .symposium-details__content { display: grid; gap: 0.18rem; }
  .symposium-details small { color: var(--text-on-light); font-size: 0.78rem; font-weight: 700; }
  .symposium-details em {
    width: fit-content;
    padding: 0.14rem 0.42rem;
    border-radius: 999px;
    color: var(--forest-mid);
    background: rgba(82,183,136,0.1);
    font-size: 0.68rem;
    font-style: normal;
    font-weight: 700;
  }
  :global([data-theme="dark"]) .symposium-details summary { color: var(--forest-canopy); }
  :global([data-theme="dark"]) .symposium-details small { color: var(--text-on-dark); }
  :global([data-theme="dark"]) .schedule-item__speaker {
    border-top-color: rgba(255,255,255,0.08);
  }
  .speaker-icon {
    font-size: 0.95rem;
    opacity: 0.75;
  }

  .agenda-calendar {
    margin: -0.5rem 0 1.75rem;
    overflow: hidden;
    border: 1px solid rgba(217, 157, 85, 0.25);
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, rgba(255,255,255,0.98), rgba(248,241,226,0.92));
    box-shadow: 0 18px 50px rgba(69, 52, 28, 0.1);
  }
  .agenda-calendar__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 1.6rem 1.2rem;
  }
  .agenda-calendar__heading h2 {
    margin: 0.15rem 0 0;
    color: var(--forest-darkest);
    font-size: clamp(1.25rem, 2.5vw, 1.8rem);
  }
  .agenda-calendar__heading p {
    max-width: 430px;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .agenda-calendar__intro-actions {
    display: grid;
    justify-items: end;
    gap: 0.75rem;
  }
  .agenda-download {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.62rem 0.8rem;
    border: 1px solid rgba(217, 157, 85, 0.5);
    border-radius: 0.7rem;
    color: #fff;
    background: linear-gradient(135deg, var(--forest-darkest), var(--forest-dark));
    box-shadow: 0 8px 20px rgba(31, 77, 59, 0.16);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .agenda-download:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(31, 77, 59, 0.22);
  }
  .agenda-download__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: var(--forest-darkest);
    background: var(--gold);
    font-size: 1.15rem;
    font-weight: 900;
  }
  .agenda-download > span:last-child { display: grid; gap: 0.08rem; }
  .agenda-download strong { font-size: 0.76rem; line-height: 1.2; }
  .agenda-download small { color: rgba(255,255,255,0.72); font-size: 0.65rem; }
  .agenda-calendar__eyebrow {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--earth-warm);
  }
  .agenda-calendar__days {
    display: flex;
    gap: 0.55rem;
    padding: 0 1.6rem 1.15rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }
  .calendar-day {
    flex: 1 0 110px;
    min-height: 62px;
    padding: 0.7rem 0.85rem;
    cursor: pointer;
    border: 1px solid rgba(45,106,79,0.15);
    border-radius: var(--radius-md);
    color: var(--forest-darkest);
    background: rgba(255,255,255,0.72);
    text-align: left;
    transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }
  .calendar-day:hover,
  .calendar-day:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(45,106,79,0.35);
    outline: 2px solid rgba(217,157,85,0.45);
    outline-offset: 2px;
  }
  .calendar-day.active {
    color: white;
    border-color: var(--forest-darkest);
    background: linear-gradient(135deg, var(--forest-darkest), var(--forest-dark));
    box-shadow: 0 8px 20px rgba(26,58,46,0.2), inset 0 -3px 0 var(--gold);
  }
  .calendar-day span,
  .calendar-day strong { display: block; }
  .calendar-day span {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    opacity: 0.72;
  }
  .calendar-day strong {
    margin-top: 0.15rem;
    color: inherit;
    font-size: 0.83rem;
  }
  .agenda-calendar__content {
    padding: 1.35rem 1.6rem 1.6rem;
    border-top: 1px solid rgba(217,157,85,0.18);
    background: rgba(255,255,255,0.45);
  }
  .agenda-calendar__panel { display: none; }
  .agenda-calendar__panel.active {
    display: block;
    animation: calendarFade 0.24s ease;
  }
  @keyframes calendarFade {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .agenda-calendar__day-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .agenda-calendar__day-heading span {
    color: var(--earth-warm);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .agenda-calendar__day-heading h3 {
    margin: 0.15rem 0 0;
    color: var(--forest-darkest);
    font-size: 1.05rem;
  }
  .agenda-calendar__day-heading > strong {
    color: var(--text-muted);
    font-size: 0.72rem;
  }
  .agenda-all-day__event {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    margin-bottom: 0.65rem;
    padding: 0.7rem 0.9rem;
    border: 1px dashed rgba(45,106,79,0.35);
    border-radius: var(--radius-sm);
    background: rgba(116,198,157,0.12);
    color: var(--forest-darkest);
    text-align: left;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .agenda-all-day__event span {
    padding: 0.22rem 0.45rem;
    border-radius: 999px;
    color: white;
    background: var(--forest-mid);
    font-size: 0.62rem;
    font-weight: 900;
    text-transform: uppercase;
  }
  .agenda-calendar__events {
    display: grid;
    gap: 0.55rem;
  }
  .agenda-event {
    width: 100%;
    border: 1px solid rgba(45,106,79,0.12);
    border-left: 4px solid var(--event-color, var(--earth-warm));
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.88);
    color: var(--text-on-light);
    text-align: left;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .agenda-event:hover,
  .agenda-event:focus-within {
    transform: translateX(3px);
    border-color: color-mix(in srgb, var(--event-color) 45%, transparent);
    box-shadow: 0 7px 18px rgba(69,52,28,0.1);
    outline: none;
  }
  .agenda-event[open] {
    transform: none;
    border-color: color-mix(in srgb, var(--event-color) 38%, transparent);
    box-shadow: 0 10px 24px rgba(69,52,28,0.1);
  }
  .agenda-event summary,
  .agenda-event__summary {
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr) 24px;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 0.9rem;
    cursor: pointer;
    list-style: none;
  }
  .agenda-event--simple {
    border-style: dashed;
    background: color-mix(in srgb, var(--event-color) 5%, white);
  }
  .agenda-event--simple:hover { transform: none; box-shadow: none; }
  .agenda-event--simple .agenda-event__arrow { font-size: 0.95rem; }
  .agenda-event summary::-webkit-details-marker { display: none; }
  .agenda-event summary:focus-visible {
    border-radius: calc(var(--radius-sm) - 2px);
    outline: 2px solid color-mix(in srgb, var(--event-color) 65%, white);
    outline-offset: 2px;
  }
  .agenda-event__time { color: var(--forest-darkest); font-size: 0.77rem; font-weight: 900; }
  .agenda-event__body { display: grid; gap: 0.12rem; min-width: 0; }
  .agenda-event__meta {
    color: var(--event-color);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .agenda-event strong {
    color: var(--forest-darkest);
    font-size: 0.84rem;
    line-height: 1.35;
  }
  .agenda-event small { color: var(--text-muted); font-size: 0.72rem; line-height: 1.35; }
  .agenda-event__arrow {
    color: var(--event-color);
    font-size: 1.2rem;
    font-weight: 800;
    text-align: center;
    transition: transform 0.2s ease;
  }
  .agenda-event[open] .agenda-event__arrow { transform: rotate(45deg); }
  .agenda-event__details {
    padding: 0 0.95rem 1rem 5.95rem;
    border-top: 1px solid color-mix(in srgb, var(--event-color) 16%, transparent);
  }
  .agenda-event__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
    padding-top: 0.85rem;
  }
  .agenda-event__facts span {
    display: grid;
    gap: 0.12rem;
    padding: 0.55rem 0.65rem;
    border-radius: 0.55rem;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--event-color) 7%, transparent);
    font-size: 0.75rem;
    line-height: 1.35;
  }
  .agenda-event__facts b,
  .agenda-event__speaker-detail b {
    color: var(--event-color);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .agenda-event__speaker-detail {
    display: grid;
    gap: 0.28rem;
    margin: 0.7rem 0 0;
    padding: 0.65rem 0.75rem;
    border-radius: 0.55rem;
    color: var(--text-on-light);
    background: rgba(255,255,255,0.72);
    font-size: 0.78rem;
    line-height: 1.45;
  }
  .agenda-event__program {
    margin-top: 0.8rem;
    padding: 0.85rem;
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--event-color) 5%, white);
  }
  .agenda-event__program h4 {
    margin: 0 0 0.75rem;
    color: var(--forest-darkest);
    font-size: 0.8rem;
  }
  .agenda-event__program ol {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .agenda-event__program li {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 0.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid color-mix(in srgb, var(--event-color) 13%, transparent);
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.45;
  }
  .agenda-event__program li:last-child { padding-bottom: 0; border-bottom: 0; }
  :global(.taxon) { font-style: italic; }
  .agenda-event__track {
    width: fit-content;
    padding: 0.14rem 0.42rem;
    border: 1px solid color-mix(in srgb, var(--event-color) 18%, transparent);
    border-radius: 999px;
    color: var(--forest-darkest);
    background: color-mix(in srgb, var(--event-color) 7%, white);
    font-size: 0.65rem;
    font-weight: 800;
  }
  .agenda-event__program em {
    width: fit-content;
    padding: 0.14rem 0.42rem;
    border-radius: 999px;
    color: var(--event-color);
    background: color-mix(in srgb, var(--event-color) 10%, transparent);
    font-size: 0.67rem;
    font-style: normal;
    font-weight: 800;
  }
  .agenda-event--s1 { --event-color:#4f83a1; }
  .agenda-event--s2 { --event-color:#5b8d63; }
  .agenda-event--s3 { --event-color:#c47c52; }
  .agenda-event--s4 { --event-color:#806b8f; }
  .agenda-event--s5 { --event-color:#4f8f88; }
  .agenda-event--mg { --event-color:#a78324; }
  .agenda-event--po { --event-color:#b85f64; }
  .agenda-event--registration { --event-color:#668da4; }
  .agenda-event--pause { --event-color:#aa8d55; }
  .agenda-event--course { --event-color:#4c8a65; }
  .agenda-event--ceremony { --event-color:#b96f46; }
  .agenda-event--posters { --event-color:#658b55; }
  .agenda-event--assembly { --event-color:#806b8f; }
  .agenda-event--general { --event-color:#7b776d; }
  :global([data-theme="dark"]) .agenda-calendar {
    border-color: rgba(217,157,85,0.2);
    background: linear-gradient(145deg, rgba(18,45,35,0.98), rgba(32,55,42,0.95));
  }
  :global([data-theme="dark"]) .agenda-calendar__heading h2,
  :global([data-theme="dark"]) .agenda-calendar__day-heading h3,
  :global([data-theme="dark"]) .agenda-event strong,
  :global([data-theme="dark"]) .agenda-event__time { color: var(--text-on-dark); }
  :global([data-theme="dark"]) .calendar-day { color: var(--text-on-dark); background: rgba(255,255,255,0.05); }
  :global([data-theme="dark"]) .calendar-day.active { background: linear-gradient(135deg, #204e3c, #2d6a4f); }
  :global([data-theme="dark"]) .agenda-calendar__content { background: rgba(0,0,0,0.08); }
  :global([data-theme="dark"]) .agenda-event { color: var(--text-on-dark); background: rgba(255,255,255,0.06); }
  :global([data-theme="dark"]) .agenda-event__speaker-detail,
  :global([data-theme="dark"]) .agenda-event__program { color: var(--text-on-dark); background: rgba(255,255,255,0.05); }
  :global([data-theme="dark"]) .agenda-event__program h4 { color: var(--text-on-dark); }

  /* Break / Registration Special Styles */
  .schedule-item--is-break {
    opacity: 0.9;
  }
  .schedule-item__break-card {
    background: white;
    border: 1px dashed rgba(217,157,85,0.25);
    border-left: 4px solid var(--s-color);
    border-radius: var(--radius-md);
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    box-shadow: var(--shadow-sm);
  }
  :global([data-theme="dark"]) .schedule-item__break-card {
    background: var(--forest-dark);
    border-color: rgba(255,255,255,0.08);
    border-left-color: var(--s-color);
  }
  .break-icon {
    font-size: 1.15rem;
  }
  .break-title {
    font-weight: 700;
    color: var(--text-on-light);
  }
  :global([data-theme="dark"]) .break-title {
    color: var(--text-on-dark);
  }
  .break-location {
    font-size: 0.78rem;
