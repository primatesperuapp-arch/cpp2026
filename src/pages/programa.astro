  simposio:      { color: '#D99D55', label: 'Simposio', icon: '🗣️' },
  ponencias:     { color: '#c9a84c', label: 'Ponencias Orales', icon: '📢' },
  posters:       { color: '#8b5e3c', label: 'Sesión de Pósters', icon: '📌' },
  taller:        { color: '#74c69d', label: 'Taller / Reunión', icon: '🔬' },
  mesa_redonda:  { color: '#e07b54', label: 'Mesa Redonda', icon: '🔵' },
  apertura:      { color: '#c9a84c', label: 'Apertura', icon: '🏛️' },
  clausura:      { color: '#c9a84c', label: 'Clausura', icon: '🏆' },
  break:         { color: '#aaa', label: 'Descanso', icon: '☕' },
  social:        { color: '#74c69d', label: 'Actividad Social', icon: '🌿' },
  inscripcion:   { color: '#aaa', label: 'Registro', icon: '📋' },
  curso:         { color: '#52B788', label: 'Curso Pre/Post-Congreso', icon: '📖' },
};

const calendarDayMeta = [
  { key: 'Pre-Congreso', weekday: 'Miércoles', date: '29 jul' },
  { key: 'Día 1', weekday: 'Jueves', date: '30 jul' },
  { key: 'Día 2', weekday: 'Viernes', date: '31 jul' },
  { key: 'Día 3', weekday: 'Sábado', date: '1 ago' },
  { key: 'Día 4', weekday: 'Domingo', date: '2 ago' },
  { key: 'Post-Congreso', weekday: 'Lunes', date: '3 ago' },
] as const;

const calendarTimes = Array.from({ length: 25 }, (_, index) => {
  const minutes = 8 * 60 + index * 30;
  const hour = Math.floor(minutes / 60);
  const minute = minutes % 60;
  return `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;
});

const allDayEvents: Partial<Record<(typeof calendarDayMeta)[number]['key'], string>> = {
  'Día 2': 'Exhibición de pósteres · Sala de estudio',
  'Día 4': 'Exhibición de pósteres · Sala de estudio',
};

function timeToMinutes(time: string) {
  const [hours, minutes] = time.split(':').map(Number);
  return hours * 60 + minutes;
}

function calendarColorKey(type: string, title: string) {
  const symposium = title.match(/Simposio\s+(\d)/i);
  if (symposium) return `s${symposium[1]}`;
  if (type === 'conferencia') return 'mg';
  if (type === 'ponencias') return 'po';
  if (type === 'curso' || type === 'taller') return 'course';
  if (type === 'break') return 'pause';
  if (type === 'inscripcion') return 'registration';
  if (type === 'posters') return 'posters';
  if (type === 'mesa_redonda') return 'assembly';
  if (['apertura', 'clausura', 'social'].includes(type)) return 'ceremony';
  return 'general';
}

function calendarCode(type: string, title: string) {
  const symposium = title.match(/Simposio\s+(\d)/i);
  if (symposium) return `S${symposium[1]}`;
  if (type === 'conferencia') return 'MG';
  if (type === 'ponencias') return 'PO';
  if (type === 'curso' || type === 'taller') return 'CUR';
  return 'GEN';
}

const calendarColumns = calendarDayMeta.map(day => {
  const daySchedule = schedule[day.key];
  return {
    ...day,
    allDay: allDayEvents[day.key],
    events: daySchedule.sessions.map(session => {
      const startMinutes = timeToMinutes(session.time);
      const parsedDuration = Number.parseInt(session.duration, 10);
      const duration = Number.isFinite(parsedDuration) ? parsedDuration : 30;
      return {
        ...session,
        code: calendarCode(session.type, session.title),
        colorKey: calendarColorKey(session.type, session.title),
        rowStart: Math.max(1, Math.floor((startMinutes - 8 * 60) / 30) + 1),
        rowSpan: Math.max(1, Math.ceil(duration / 30)),
      };
    }),
  };
});
