<PageLayout
  title="Programa"
  description="Programa completo del III Congreso Peruano de Primatología 2026: conferencias magistrales, simposios, talleres, ponencias y sesiones de pósters."
  heroTitle="Programa"
  heroSubtitle="Agenda científica del III Congreso Peruano de Primatología 2026"
  heroColor="var(--earth-dark)"
>
  <!-- Nota -->
  <section class="section" style="padding-top: 2rem; padding-bottom: 2rem;">
    <div class="container">
      <div class="agenda-calendar reveal" aria-label="Agenda interactiva del congreso">
        <div class="agenda-calendar__heading">
          <div>
            <span class="agenda-calendar__eyebrow">Agenda visual</span>
            <h2>Calendario del congreso</h2>
          </div>
          <div class="agenda-calendar__intro-actions">
            <p>Selecciona un día y abre cada actividad para consultar ponentes, moderación, afiliaciones y presentaciones.</p>
          </div>
        </div>

        <div class="agenda-calendar__days" role="tablist" aria-label="Días del congreso">
          {calendarColumns.map((day, index) => (
            <button
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`calendar-panel-${index}`}
              class={`calendar-day ${index === 0 ? 'active' : ''}`}
              data-calendar-target={day.key}
            >
              <span>{day.weekday}</span>
              <strong>{day.date}</strong>
            </button>
          ))}
        </div>

        <div class="agenda-calendar__content">
          {calendarColumns.map((day, index) => (
            <div
              id={`calendar-panel-${index}`}
              role="tabpanel"
              class={`agenda-calendar__panel ${index === 0 ? 'active' : ''}`}
              data-calendar-panel={day.key}
            >
              <div class="agenda-calendar__day-heading">
                <div>
                  <span>{day.weekday}</span>
                  <h3>{day.date} · {schedule[day.key].theme}</h3>
                </div>
                <strong>{day.events.length} {day.events.length === 1 ? 'actividad' : 'actividades'}</strong>
              </div>

              {day.allDay && (
                <div class="agenda-all-day__event">
                  <span>Todo el día</span>
                  <strong>{day.allDay}</strong>
                </div>
              )}

              <div class="agenda-calendar__events">
                {day.events.map(event => {
                  const cfg = typeConfig[event.type] || typeConfig.ponencias;
                  const details = event.detailsId ? symposiumDetails[event.detailsId] : null;
                  const interventionCount = details?.length || 0;
                  if (event.type === 'break') {
                    return (
                      <div class={`agenda-event agenda-event--${event.colorKey} agenda-event--simple`}>
                        <div class="agenda-event__summary">
                          <span class="agenda-event__time">{event.time}</span>
                          <span class="agenda-event__body">
                            <span class="agenda-event__meta">{event.duration}</span>
                            <strong>{event.title}</strong>
                          </span>
                          <span class="agenda-event__arrow" aria-hidden="true">☕</span>
                        </div>
                      </div>
                    );
                  }
                  return (
                    <details class={`agenda-event agenda-event--${event.colorKey}`}>
                      <summary>
                        <span class="agenda-event__time">{event.time}</span>
                        <span class="agenda-event__body">
                          <span class="agenda-event__meta">{event.code} · {event.duration}</span>
                          <strong set:html={formatScientificNames(event.title)} />
                          {event.speaker && <small>{event.speaker}</small>}
                        </span>
                        <span class="agenda-event__arrow" aria-hidden="true">+</span>
                      </summary>

                      <div class="agenda-event__details">
                        <div class="agenda-event__facts">
                          <span><b>{cfg.icon} Tipo</b>{cfg.label}</span>
                          {event.location && <span><b>📍 Lugar</b>{event.location}</span>}
                          {event.moderator && <span><b>🎙️ Moderación</b>{event.moderator}</span>}
                        </div>

                        {event.speaker && (
                          <p class="agenda-event__speaker-detail">
                            <b>👤 Ponentes y participantes</b>
                            <span>{event.speaker}</span>
                          </p>
                        )}

                        {details && (
                          <div class="agenda-event__program">
                            <h4>{event.detailsLabel || 'Programa detallado'} · {interventionCount} intervenciones</h4>
                            <ol>
                              {details.map(item => (
                                <li>
                                  <span class="symposium-details__time">{item.time}</span>
                                  <span class="symposium-details__content">
                                    <span set:html={formatScientificNames(item.title)} />
                                    {item.speaker && <small>{item.speaker}</small>}
                                    {item.track && <span class="agenda-event__track">{item.track}</span>}
                                    {item.affiliation && <em>{item.affiliation}</em>}
                                  </span>
                                </li>
                              ))}
                            </ol>
                          </div>
                        )}
                      </div>
                    </details>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="program-note reveal">
        <div class="program-note__icon">📌</div>
        <div class="program-note__text">
          <strong>Actualizado:</strong> Programa sincronizado con el archivo vigente, incluyendo títulos de magistrales, 13 presentaciones orales y 17 pósteres aceptados.
        </div>
      </div>

      <!-- Leyenda -->
      <div class="legend reveal">
        {Object.entries(typeConfig).filter(([k]) => !['inscripcion','break','apertura','clausura'].includes(k)).map(([, v]) => (
          <span class="legend-item" style={`--lc: ${v.color};`}>
            {v.icon} {v.label}
          </span>
        ))}
      </div>
    </div>
  </section>

</PageLayout>

<script>
  const calendarDays = document.querySelectorAll('.calendar-day');
  const calendarPanels = document.querySelectorAll('.agenda-calendar__panel');

  function activateCalendarDay(target: string) {
    calendarDays.forEach(day => {
      const isActive = (day as HTMLElement).dataset.calendarTarget === target;
      day.classList.toggle('active', isActive);
      day.setAttribute('aria-selected', String(isActive));
    });
    calendarPanels.forEach(panel => {
      panel.classList.toggle('active', (panel as HTMLElement).dataset.calendarPanel === target);
    });
  }

  calendarDays.forEach(day => {
    day.addEventListener('click', () => {
      const target = (day as HTMLElement).dataset.calendarTarget || '';
      activateCalendarDay(target);
    });
  });
</script>

