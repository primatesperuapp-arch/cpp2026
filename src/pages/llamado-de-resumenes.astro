---
import PageLayout from '../layouts/PageLayout.astro';
import axes from '../data/thematic-axes.json';
import { getWebState } from '../utils/webState';

const { abstracts } = getWebState();

// Build-time logic for buttons
let resumenHref = "https://forms.gle/Gzcr2ktTmrEnGTTh9";
let alertBtnLabel = "Enviar Resumen →";
let ctaBtnLabel = "📋 Enviar Resumen";
let alertBtnClasses = "btn btn-primary";
let ctaBtnClasses = "btn btn-primary btn-lg";
let isTargetBlank = true;

if (abstracts === 'upcoming') {
  resumenHref = "#";
  alertBtnLabel = "Próximamente";
  ctaBtnLabel = "📋 Próximamente";
  alertBtnClasses = "btn btn-primary btn-muted-cta";
  ctaBtnClasses = "btn btn-primary btn-lg btn-muted-cta";
  isTargetBlank = false;
} else if (abstracts === 'closed') {
  resumenHref = "#";
  alertBtnLabel = "Convocatoria Cerrada";
  ctaBtnLabel = "📋 Envío Cerrado";
  alertBtnClasses = "btn btn-primary btn-muted-cta";
  ctaBtnClasses = "btn btn-primary btn-lg btn-muted-cta";
  isTargetBlank = false;
}

const faqs = [
  {
    q: "¿Cuántas palabras puede tener el resumen?",
    a: "Los resúmenes para ponencias orales y pósters deben tener entre 250 y 350 palabras, sin incluir el título ni los autores. Los simposios pueden enviar hasta 400 palabras de descripción general."
  },
  {
    q: "¿Puedo enviar más de un resumen?",
    a: "Sí, cada autor puede ser primer autor de un máximo de 2 resúmenes, y coautor sin límite de número."
  },
  {
    q: "¿En qué idioma debo enviar el resumen?",
    a: "Se aceptan resúmenes en español e inglés. Para esta edición, el español es el idioma principal del congreso."
  },
  {
    q: "¿Cómo serán evaluados los resúmenes?",
    a: "Cada resumen será revisado por al menos dos miembros del comité científico en proceso de doble ciego. Se evaluará: relevancia temática, claridad, originalidad, metodología y aporte a la conservación."
  },
  {
    q: "¿Los autores aceptados deben inscribirse al congreso?",
    a: "Sí. La aceptación del resumen no incluye la inscripción. Todos los autores que presenten deben estar inscritos antes de la fecha límite indicada."
  },
  {
    q: "¿Se publicarán los resúmenes aceptados?",
    a: "Los resúmenes aceptados serán publicados en el libro de resúmenes del congreso con ISBN. Estamos explorando opciones de publicación de artículos completos en revistas afiliadas."
  },
];

---

<PageLayout
  title="Llamado de Resúmenes"
  description="Llamado a la Presentación de Resúmenes: III Congreso Peruano de Primatología. Integrando Ciencias, Saberes y Sociedad para la Conservación en el Perú."
  heroTitle="Llamado de Resúmenes"
  heroSubtitle="III Congreso Peruano de Primatología: Integrando Ciencias, Saberes y Sociedad para la Conservación en el Perú"
  heroColor="var(--forest-mid)"
>

  <!-- Intro + Deadline Alert -->
  <section class="section">
    <div class="container">
      <div class="call-intro">
        <div class="deadline-alert reveal">
          <div class="deadline-alert__icon" id="call-status-icon">
            {abstracts === 'upcoming' && '⏰'}
            {abstracts === 'open' && '🟢'}
            {abstracts === 'closed' && '🔴'}
          </div>
          <div class="deadline-alert__text">
            <span class={`status-badge status-badge--${abstracts}`} id="call-status-badge">
              {abstracts === 'upcoming' && 'Próximamente'}
              {abstracts === 'open' && 'Convocatoria Abierta'}
              {abstracts === 'closed' && 'Convocatoria Cerrada'}
            </span>
            <br />
            {abstracts === 'closed' ? (
              <strong>El plazo de envío de resúmenes ha concluido el 14 de julio de 2026. La convocatoria de resúmenes se encuentra cerrada.</strong>
            ) : (
              <span><strong>Apertura:</strong> 08 de mayo 2026 &nbsp;|&nbsp; <strong>Cierre:</strong> 14 de julio 2026 (¡Extendido!)</span>
            )}
          </div>
          {abstracts !== 'closed' && (
            <div class="deadline-alert__actions" style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
              <a 
                href={resumenHref} 
                target={isTargetBlank ? "_blank" : undefined} 
                rel={isTargetBlank ? "noopener" : undefined} 
                class={alertBtnClasses} 
                id="alert-enviar-resumen"
              >
                {alertBtnLabel}
              </a>
            </div>
          )}
        </div>

        <p class="call-desc reveal">
          <strong>Lugar:</strong> Facultad de Medicina Veterinaria UNMSM (Av. Circunvalación 28, San Borja, Lima).<br /><br />
          El Comité Organizador del III Congreso Peruano de Primatología se complace en invitar a investigadores, estudiantes, gestores de áreas protegidas, organizaciones indígenas, comunidades locales, centros de rescate y artistas de conservación a presentar sus propuestas. 
          Alineados con el Plan Nacional de Conservación de Primates Amenazados del Perú (2019-2029) impulsado por el SERFOR, este congreso es una plataforma para articular esfuerzos interdisciplinarios y construir soluciones de manejo colaborativo.
          Hacemos un llamado a investigaciones rigurosas y experiencias de base que exploren la biología evolutiva, el bienestar animal y el rol humano en la persistencia de las especies.
        </p>
      </div>
    </div>
  </section>

  <!-- Lineamientos de Exposición (Presentaciones Orales y Pósters) -->
  <section class="section" style="background: var(--cream-warm);">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Para Trabajos Aceptados</span>
        <h2 class="section-title">Lineamientos de Exposición</h2>
        <p class="section-subtitle" style="max-width: 800px; margin-left: auto; margin-right: auto;">
          Si tu propuesta ha sido aceptada para su presentación en el congreso, por favor sigue rigurosamente las siguientes instrucciones técnicas y recomendaciones de diseño según tu modalidad de exposición.
        </p>
      </div>

      <!-- Tabs Component -->
      <div class="presentation-tabs reveal">
        <div class="tabs-header">
          <button class="tab-btn active" data-tab="orales">
            <span class="tab-btn__icon">🎤</span>
            <span class="tab-btn__text">Presentaciones Orales</span>
          </button>
          <button class="tab-btn" data-tab="posters">
            <span class="tab-btn__icon">📌</span>
            <span class="tab-btn__text">Pósters Científicos</span>
          </button>
        </div>

        <div class="tabs-content">
          <!-- PANEL: ORALES -->
          <div class="tab-panel active" id="tab-panel-orales">
            <div class="poster-instructions-grid">
              
              <!-- Especificaciones Técnicas (Orales) -->
              <div class="poster-card-tech">
                <h3>📐 Especificaciones Técnicas</h3>
                <ul class="poster-list">
                  <li><strong>Modalidades:</strong> Ponencias Orales, Relatos de Experiencia y Charlas Relámpago.</li>
                  <li><strong>Relación de Aspecto:</strong> Formato horizontal <strong>16:9</strong> (Widescreen).</li>
                  <li><strong>Formatos de Archivo:</strong> Guardar y entregar en formato <strong>PDF</strong> o <strong>PowerPoint (.pptx)</strong>. Se recomienda fuertemente exportar a PDF para asegurar que las fuentes y diagramas no se desconfiguren.</li>
                  <li><strong>Tipografías y Tamaños:</strong> Usar fuentes Sans-serif legibles (Outfit, Arial, Helvetica). Se aconseja títulos &gt; 32 pt y texto de contenido &gt; 20 pt.</li>
                </ul>
              </div>

              <!-- Duración y Tiempos -->
              <div class="poster-card-content">
                <h3>⏱️ Duración y Tiempos de Exposición</h3>
                <p class="poster-card-desc-intro" style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 1.25rem;">
                  El respeto a los tiempos asignados es crucial para el correcto flujo del programa. Las sesiones contarán con moderadores estrictos:
                </p>
                <div class="poster-structure-mini-grid">
                  <div class="structure-mini-item">
                    <strong>Ponencias Orales Académicas:</strong>
                    <span><strong>15 minutos en total:</strong> 12 minutos para la exposición y 3 minutos para preguntas y discusión.</span>
                  </div>
                  <div class="structure-mini-item">
                    <strong>Relatos de Experiencia (Comunitario/Práctico):</strong>
                    <span><strong>15 minutos en total:</strong> 12 minutos de presentación narrativa y 3 minutos para preguntas.</span>
                  </div>
                  <div class="structure-mini-item">
                    <strong>Charlas Relámpago (Lightning Talks):</strong>
                    <span><strong>5 minutos en total:</strong> Presentación ágil y directa. Las preguntas se realizarán al final de toda la sesión.</span>
                  </div>
                </div>
              </div>

            </div>

            <!-- Recomendaciones y Canva -->
            <div class="poster-tips-box">
              <h3>🎨 Recomendaciones de Diseño y Entrega</h3>
              <div class="poster-tips-grid">
                <div class="tip-item">
                  <span class="tip-icon">⏰</span>
                  <strong>Recepción de Material</strong>
                  <p>Entrega tu archivo al equipo de soporte técnico en la mesa de control de la sala asignada con al menos <strong>2 horas de anticipación</strong> a tu exposición, o al inicio del día (8:30 a.m.).</p>
                </div>
                <div class="tip-item">
                  <span class="tip-icon">🎨</span>
                  <strong>Plantilla Oficial</strong>
                  <p>Usa la plantilla oficial de Canva diseñada con la paleta de colores y fuentes oficiales para tu comodidad.
                     <br /><br />
                     <a href="https://canva.link/d8iliog91u4up88" target="_blank" rel="noopener noreferrer" class="btn btn-sm" style="background: var(--gold); color: white; border: none; display: inline-flex; align-items: center; gap: 0.35rem; width: 100%; justify-content: center;">
                       <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                       Editar en Canva
                     </a>
                  </p>
                </div>
                <div class="tip-item">
                  <span class="tip-icon">👁️</span>
                  <strong>Diseño Visual</strong>
                  <p>Evita el exceso de texto. Las diapositivas deben actuar como apoyo visual: prioriza fotos de campo, mapas, gráficos estadísticos y esquemas.</p>
                </div>
                <div class="tip-item">
                  <span class="tip-icon">🗣️</span>
                  <strong>Claridad Expositiva</strong>
                  <p>Habla con claridad, proyecta la voz y modera la velocidad para asegurar que el mensaje llegue a todo el auditorio, incluidos miembros no académicos.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- PANEL: POSTERS -->
          <div class="tab-panel" id="tab-panel-posters">
            <div class="poster-instructions-grid">
              
              <!-- Especificaciones Técnicas (Pósters) -->
              <div class="poster-card-tech">
                <h3>📐 Especificaciones Técnicas</h3>
                <ul class="poster-list">
                  <li><strong>Orientación:</strong> Vertical (Portrait) únicamente.</li>
                  <li><strong>Dimensiones:</strong> Medida estándar internacional <strong>A0</strong> (841 mm de ancho x 1189 mm de alto).</li>
                  <li><strong>Material de Impresión:</strong> Papel grueso mate (de preferencia 150g o superior) o banner fotográfico con ojales discretos. Evitar papel satinado (brillante) ya que genera reflejos molestos con la iluminación de las salas.</li>
                  <li><strong>Montaje:</strong> El congreso proveerá el material adhesivo (cinta doble contacto) o los soportes correspondientes en el área de exposición.</li>
                </ul>
              </div>

              <!-- Estructura Sugerida -->
              <div class="poster-card-content">
                <h3>📝 Estructura del Contenido</h3>
                <p class="poster-card-desc-intro" style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 1.25rem;">
                  Un póster científico efectivo debe poder leerse y entenderse en <strong>menos de 5 minutos</strong>. Sugerimos la siguiente distribución de elementos:
                </p>
                <div class="poster-structure-mini-grid">
                  <div class="structure-mini-item">
                    <strong>Encabezado principal:</strong>
                    <span>Título visible a 2 metros, nombres de autores, afiliaciones institucionales, correo de contacto y logos oficiales en la parte superior.</span>
                  </div>
                  <div class="structure-mini-item">
                    <strong>Introducción y Objetivos:</strong>
                    <span>Muy concisos (máximo 150 palabras). Plantea la justificación, pregunta central y las hipótesis de forma directa.</span>
                  </div>
                  <div class="structure-mini-item">
                    <strong>Metodología:</strong>
                    <span>Usa diagramas de flujo, mapas del área de estudio o esquemas ilustrativos. Minimiza el texto descriptivo.</span>
                  </div>
                  <div class="structure-mini-item">
                    <strong>Resultados:</strong>
                    <span>El núcleo del póster. Destaca gráficos estadísticos legibles, fotos de campo de alta calidad o tablas clave con leyendas breves.</span>
                  </div>
                  <div class="structure-mini-item">
                    <strong>Conclusiones y Discusión:</strong>
                    <span>En forma de viñetas claras que respondan al objetivo y enfaticen la relevancia práctica para la conservación.</span>
                  </div>
                </div>
              </div>

            </div>

            <!-- Consejos de Diseño -->
            <div class="poster-tips-box" style="margin-top: 2rem;">
              <h3>🎨 Recomendaciones de Diseño y Legibilidad</h3>
              <div class="poster-tips-grid">
                <div class="tip-item">
                  <span class="tip-icon">👁️</span>
                  <strong>Regla del 60/40</strong>
                  <p>El póster debe ser 60% visual (gráficos, fotos, mapas) y solo 40% texto corrido. El exceso de letras aburre y disminuye la lectura.</p>
                </div>
                <div class="tip-item">
                  <span class="tip-icon">🔤</span>
                  <strong>Tipografías y Tamaños</strong>
                  <p>Usa fuentes Sans-serif legibles a distancia (Outfit, Arial, Helvetica). Título principal &gt;72 pt, subtítulos ~36 pt, y cuerpo ~24-28 pt.</p>
                </div>
                <div class="tip-item">
                  <span class="tip-icon">🌈</span>
                  <strong>Contraste cromático</strong>
                  <p>Elige fondos claros (blanco, crema, gris muy suave) con texto en colores oscuros. Limita tu paleta de color a un esquema de 3 o 4 tonos.</p>
                </div>
                <div class="tip-item">
                  <span class="tip-icon">📱</span>
                  <strong>Código QR (Opcional)</strong>
                  <p>Te recomendamos incluir un código QR pequeño en una de las esquinas inferiores para que los asistentes descarguen el PDF de tu póster.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categorías -->
  <section class="section" style="background: var(--cream-warm);">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="section-title">Las Líneas de Acción</h2>
        <p class="section-subtitle" style="max-width: 800px; margin-left: auto; margin-right: auto;">
          Para que el conocimiento compartido tenga un impacto en las políticas de nuestro país, el III Congreso Peruano de Primatología 2026 ha organizado sus sesiones académicas, simposios y mesas de trabajo en torno a <strong>4 Ejes Temáticos</strong> alineados con los objetivos del Plan Nacional de Conservación de primates amenazados del Perú (SERFOR).
          <br /><br />
          Al estructurar el evento de esta manera, garantizamos que cada presentación contribuya directamente a las metas nacionales de conservación, facilitando el diálogo entre la academia, el Estado y la sociedad civil.
        </p>
      </div>

      <div class="axes-list reveal">
        {axes.map(axis => (
          <div class="axis-row" style={`--c: ${axis.color};`}>
            <div class="axis-row__emoji">{axis.emoji}</div>
            <div class="axis-row__info">
              <span class="axis-row__code" style={`color: ${axis.color};`}>[{axis.code}]</span>
              <strong class="axis-row__name">{axis.title}</strong>
              <span class="axis-row__desc">{axis.description}</span>
              {axis.subtopics && (
                <div class="axis-row__tags">
                  {axis.subtopics.map(topic => (
                    <span class="axis-tag" style={`--c: ${axis.color};`}>{topic}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Formatos -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">¿Cómo participar?</span>
        <h2 class="section-title">Formatos de Presentación</h2>
      </div>

      <div class="formats-grid">
        {[
          { icon: "🎤", name: "Ponencias Orales", time: "15 min", desc: "Presentación de datos empíricos, resultados de investigaciones biológicas o análisis sociales cuantitativos/cualitativos.", badge: "" },
          { icon: "📖", name: "Relatos de Experiencia", time: "15 min", desc: "Modalidad para gestores y comunidades; se centra en la narrativa práctica de la conservación y lecciones operativas.", badge: "Práctico" },
          { icon: "⚡", name: "Charlas Relámpago", time: "5 min", desc: "Formato visual ágil para investigaciones en curso, innovaciones tecnológicas o denuncias de conservación.", badge: "Lightning" },
          { icon: "📌", name: "Póster", time: "En físico", desc: "Infografías científicas, mapas participativos o colecciones de fotografía/arte orientadas a la divulgación.", badge: "" },
          { icon: "🗣️", name: "Simposios / Mesas Redondas", time: "90 min", desc: "Panel multidisciplinario para discutir temas críticos, garantizando la integración de diversas voces.", badge: "90 min" },
          { icon: "🛠️", name: "Talleres Colaborativos", time: "Sesiones", desc: "Sesiones de transferencia de habilidades prácticas, técnicas, analíticas o de políticas.", badge: "" }
        ].map((f, i) => (
          <div class={`format-card reveal reveal-delay-${i+1}`}>
            <div class="format-card__icon">{f.icon}</div>
            {f.badge && <span class="format-card__badge">{f.badge}</span>}
            <h3 class="format-card__name">{f.name}</h3>
            <div class="format-card__time">⏱ {f.time}</div>
            <p class="format-card__desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Lineamientos -->
  <section class="section" style="background: var(--cream-warm);">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Instrucciones</span>
        <h2 class="section-title">Lineamientos de Envío</h2>
        <p class="section-subtitle">Asegúrate de que tu propuesta cumpla con los estándares del congreso para facilitar su evaluación.</p>
      </div>

      <div class="requirements-grid reveal">
        <div class="requirement-box">
          <h3>📋 Requisitos Generales</h3>
          <ul>
            <li>Envío exclusivo a través del <strong>formulario oficial</strong> en línea.</li>
            <li>Extensión máxima de <strong>300 palabras</strong> para el resumen descriptivo.</li>
            <li>El título debe reflejar claramente el <strong>objetivo y la idea principal</strong> del trabajo.</li>
          </ul>
        </div>

        <div class="requirement-box" style="border-left-color: var(--gold);">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1.5rem;">
            <div>
              <h3>🎨 Plantilla de Presentación</h3>
              <ul>
                <li>Recomendamos usar la <strong>plantilla oficial del congreso</strong> para tus diapositivas.</li>
                <li>El diseño está optimizado en <strong>colores, tipografía y legibilidad</strong> para el congreso.</li>
                <li>Disponible para edición rápida y directa en la plataforma <strong>Canva</strong>.</li>
              </ul>
            </div>
             <a href="https://canva.link/d8iliog91u4up88" target="_blank" rel="noopener noreferrer" class="btn" style="background: var(--gold); color: white; border: none; flex-shrink: 0; display: inline-flex; align-items: center; gap: 0.5rem; width: fit-content;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              Editar en Canva
            </a>
          </div>
        </div>
      </div>

      <div class="structure-section reveal">
        <h3>📐 Estructura del Resumen</h3>
        <p>El contenido debe organizarse según la categoría de tu participación:</p>
        
        <div class="structure-grid">
          <div class="structure-card">
            <h4>Científicas (Empíricas)</h4>
            <p>Incluir: Contexto/objetivo, métodos (diseño, muestra), resultados (datos concretos) y conclusiones.</p>
          </div>
          <div class="structure-card">
            <h4>Relatos Comunitarios / Descriptivos</h4>
            <p>Incluir: Situación/problemática, acciones implementadas, desafíos superados e impacto real.</p>
          </div>
        </div>
      </div>
    </div>
  <!-- Criterios de Evaluación -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Proceso de Evaluación</span>
        <h2 class="section-title">Evaluación por Pares</h2>
        <p class="section-subtitle">
          Un Comité Científico Transdisciplinario revisará los resúmenes mediante un proceso ciego, empleando rúbricas que valoran la solidez técnica y la aplicabilidad práctica según el Plan Nacional del SERFOR (hábitats, caza y gobernanza).
        </p>
      </div>

      <div class="policy-table reveal">
        <table>
          <thead>
            <tr>
              <th>Dimensión</th>
              <th>Enfoque Académico / Tecnológico</th>
              <th>Enfoque de Relatos / Divulgación</th>
              <th>Peso</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Relevancia Estratégica</strong></td>
              <td>Aborda vacíos y se vincula al Plan Nacional SERFOR.</td>
              <td>Responde a amenazas locales o carencias educativas.</td>
              <td class="policy-green">20%</td>
            </tr>
            <tr>
              <td><strong>Rigor Metodológico</strong></td>
              <td>Diseño robusto, replicable y ético.</td>
              <td>Planificación estructurada y conocimiento del contexto.</td>
              <td class="policy-green">25%</td>
            </tr>
            <tr>
              <td><strong>Impacto y Efectividad</strong></td>
              <td>Provee modelos predictivos, teóricos o de manejo.</td>
              <td>Impactos tangibles (reducción de caza, empoderamiento).</td>
              <td class="policy-green">25%</td>
            </tr>
            <tr>
              <td><strong>Equidad y Ética</strong></td>
              <td>Evita "ciencia paracaidista", colabora con pares locales.</td>
              <td>Respeta saberes originarios y asegura representatividad.</td>
              <td class="policy-green">15%</td>
            </tr>
            <tr>
              <td><strong>Claridad Expositiva</strong></td>
