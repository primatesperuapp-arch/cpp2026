    color: var(--forest-canopy);
  }
  .tab-btn.active {
    color: var(--forest-mid);
    background: rgba(255, 255, 255, 0.95);
    border-bottom-color: var(--gold);
  }
  :global([data-theme="dark"]) .tab-btn.active {
    color: var(--forest-canopy);
    background: rgba(26, 58, 46, 0.6);
  }

  .tabs-content {
    padding: 2.5rem;
  }

  .tab-panel {
    display: none;
  }
  .tab-panel.active {
    display: block;
    animation: tabFadeIn 0.4s ease;
  }

  @keyframes tabFadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .tab-btn {
      flex-direction: column;
      padding: 1rem 0.5rem;
      font-size: 0.95rem;
      gap: 0.35rem;
    }
    .tabs-content {
      padding: 1.5rem;
    }
  }
</style>

<script>
  import { getWebState } from '../utils/webState';

  function updateAbstractsState() {
    const { abstracts } = getWebState();

    // 1. Update icon & badge
    const statusIconEl = document.getElementById('call-status-icon');
    const statusBadgeEl = document.getElementById('call-status-badge');

    if (statusIconEl) {
      statusIconEl.textContent = abstracts === 'upcoming' ? '⏰' : (abstracts === 'open' ? '🟢' : '🔴');
    }

    if (statusBadgeEl) {
      statusBadgeEl.textContent = abstracts === 'upcoming' ? 'Próximamente' : (abstracts === 'open' ? 'Convocatoria Abierta' : 'Convocatoria Cerrada');
      statusBadgeEl.className = 'status-badge status-badge--' + abstracts;
    }

    // 2. Update buttons
    const alertBtn = document.getElementById('alert-enviar-resumen');
    const ctaBtn = document.getElementById('cta-enviar-resumen');

    [alertBtn, ctaBtn].forEach((btn) => {
      if (!btn) return;
      
      btn.classList.remove('btn-muted-cta');
      
      if (abstracts === 'upcoming') {
        btn.setAttribute('href', '#');
        btn.removeAttribute('target');
        btn.removeAttribute('rel');
        btn.classList.add('btn-muted-cta');
        if (btn.id === 'alert-enviar-resumen') {
          btn.textContent = 'Próximamente';
        } else {
          btn.textContent = '📋 Próximamente';
        }
      } else if (abstracts === 'closed') {
        btn.style.display = 'none';
      } else {
        btn.setAttribute('href', 'https://forms.gle/Gzcr2ktTmrEnGTTh9');
        btn.setAttribute('target', '_blank');
        btn.setAttribute('rel', 'noopener');
        if (btn.id === 'alert-enviar-resumen') {
          btn.textContent = 'Enviar Resumen →';
        } else {
          btn.textContent = '📋 Enviar Resumen';
        }
      }
    });
  }

  // Handle Tabs Navigation
  function initTabs() {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');
        
        tabBtns.forEach(b => b.classList.remove('active'));
        tabPanels.forEach(p => p.classList.remove('active'));

        btn.classList.add('active');
        const activePanel = document.getElementById(`tab-panel-${targetTab}`);
        if (activePanel) {
          activePanel.classList.add('active');
        }
      });
    });
  }

  // Run on startup
  updateAbstractsState();
  initTabs();
  
  // Listen for Astro transitions page load
  document.addEventListener('astro:page-load', () => {
    updateAbstractsState();
    initTabs();
  });
</script>
