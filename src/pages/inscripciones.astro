<script>
  import { getWebState } from '../utils/webState';

  function updatePricingDetails() {
    const { pricing: pricingTier } = getWebState();

    // 1. Update the alert message and extension banner visibility
    const alertCard = document.getElementById('pricing-alert');
    const alertIcon = document.getElementById('pricing-alert-icon');
    const alertText = document.getElementById('pricing-alert-text');
    const extensionBanner = document.getElementById('pricing-extension-banner');

    if (alertCard) {
      alertCard.className = `early-bird-alert early-bird-alert--${pricingTier} reveal visible`;
    }

    if (extensionBanner) {
      if (pricingTier === 'early') {
        extensionBanner.style.display = 'flex';
      } else {
        extensionBanner.style.display = 'none';
      }
    }

    if (alertIcon) {
      alertIcon.textContent = pricingTier === 'early' ? '⏰' : (pricingTier === 'regular' ? '🟢' : '🏢');
    }

    if (alertText) {
      if (pricingTier === 'early') {
        alertText.innerHTML = '<strong>Inscripciones Early Bird — ¡Extendidas!</strong> — Tarifa especial disponible hasta el <strong>20 de junio de 2026</strong>. ¡Inscríbete ahora y ahorra!';
      } else if (pricingTier === 'regular') {
        alertText.innerHTML = '<strong>Tarifa Regular Activa</strong> — La preventa Early Bird finalizó el 20 de junio de 2026. ¡Registra tu inscripción antes del 15 de julio de 2026!';
      } else if (pricingTier === 'onsite') {
        alertText.innerHTML = '<strong>Tarifa En Sede Activa</strong> — La etapa de pre-registro regular finalizó. Inscríbete directamente de manera presencial durante el evento.';
      }
    }

    // 2. Update the columns styling
    const allTierElements = document.querySelectorAll('.pricing-table [data-tier]');
    allTierElements.forEach((el) => {
      const tier = el.getAttribute('data-tier');
      el.classList.remove('active-tier-header', 'active-tier-cell', 'completed-tier');

      if (tier === pricingTier) {
        if (el.tagName === 'TH') {
          el.classList.add('active-tier-header');
        } else {
          el.classList.add('active-tier-cell');
        }
      } else {
        // Classify as completed or not
        const isEarlyCompleted = pricingTier === 'regular' || pricingTier === 'onsite';
        const isRegularCompleted = pricingTier === 'onsite';

        if (tier === 'early' && isEarlyCompleted) {
          el.classList.add('completed-tier');
        } else if (tier === 'regular' && isRegularCompleted) {
          el.classList.add('completed-tier');
        }
      }
    });
  }

  // Run on startup
  updatePricingDetails();
  // Listen for Astro transitions page load
  document.addEventListener('astro:page-load', updatePricingDetails);
</script>
