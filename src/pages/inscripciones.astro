---
import PageLayout from '../layouts/PageLayout.astro';
import pricing from '../data/pricing.json';
import { getWebState } from '../utils/webState';
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/';

const pricingTier = getWebState().pricing as any;
---

<PageLayout
  title="Inscripciones"
  description="Información sobre categorías, precios y proceso de inscripción al III Congreso Peruano de Primatología 2026."
  heroTitle="Inscripciones"
  heroSubtitle="Regístrate en el III Congreso Peruano de Primatología 2026"
  heroColor="var(--earth-mid)"
>
  <!-- Botón de Inscripción Directa -->
  <section class="section" style="padding-bottom: 0;">
    <div class="container">
      <div class="reveal" style="text-align:center; margin-bottom: 1rem;">
        <a href="https://forms.gle/nTKgiQEpBX1GJtc19" target="_blank" rel="noopener" class="btn btn-primary btn-lg" style="box-shadow: 0 10px 30px rgba(217,157,85,0.25);">
          📋 Ir al Formulario de Inscripción →
        </a>
      </div>
    </div>
  </section>

  <!-- Early Bird Extension & Alert -->
  <section class="section">
    <div class="container">
      <!-- Extension Special Banner -->
      {pricingTier === 'early' && (
        <div class="early-bird-extension reveal" id="pricing-extension-banner">
          <div class="extension-badge">🎉 ¡EXTENDIDO!</div>
          <div class="extension-content">
            <h3 class="extension-title">¡Gran decisión inscribirte en el Early Bird!</h3>
            <p class="extension-subtitle">
              Hemos extendido la tarifa especial hasta el <strong>20 de junio de 2026</strong>. Esta es tu oportunidad perfecta de asegurar tu lugar al mejor precio. ¡Quienes se inscriben temprano son quienes aprovechan lo mejor del congreso!
            </p>
            <div class="extension-countdown">
              <span class="extension-icon">🐒</span>
              <span>¡No lo dejes para después! Únete a la comunidad primatológica con el precio más accesible del año.</span>
            </div>
          </div>
        </div>
      )}

      <div class={`early-bird-alert early-bird-alert--${pricingTier} reveal`} id="pricing-alert">
        <div class="early-bird-alert__icon" id="pricing-alert-icon">
          {pricingTier === 'early' ? '⏰' : (pricingTier === 'regular' ? '🟢' : '🏢')}
        </div>
        <div id="pricing-alert-text">
          {pricingTier === 'early' && (
            <><strong>Inscripciones Early Bird — ¡Extendidas!</strong> — Tarifa especial disponible hasta el <strong>20 de junio de 2026</strong>. ¡Inscríbete ahora y ahorra!</>
          )}
          {pricingTier === 'regular' && (
            <><strong>Tarifa Regular Activa</strong> — La preventa Early Bird finalizó el 20 de junio de 2026. ¡Registra tu inscripción antes del 15 de julio de 2026!</>
          )}
          {pricingTier === 'onsite' && (
            <><strong>Tarifa En Sede Activa</strong> — La etapa de pre-registro regular finalizó. Inscríbete directamente de manera presencial durante el evento.</>
          )}
        </div>
      </div>

      <!-- Pricing Table -->
      <div class="pricing-table-wrapper reveal">
        <table class="pricing-table">
          <thead>
            <tr>
              <th rowspan="2">Categoría</th>
              <th colspan="2" data-tier="early" class={pricingTier === 'early' ? 'active-tier-header' : (pricingTier !== 'early' ? 'completed-tier' : '')}>Early Bird <br /><small>(hasta 20 junio) 🎉</small></th>
              <th colspan="2" data-tier="regular" class={pricingTier === 'regular' ? 'active-tier-header' : (pricingTier === 'onsite' ? 'completed-tier' : '')}>Regular <br /><small>(hasta 15 julio)</small></th>
              <th colspan="2" data-tier="onsite" class={pricingTier === 'onsite' ? 'active-tier-header' : ''}>En sede <br /><small>(Durante el congreso)</small></th>
            </tr>
            <tr>
              <th data-tier="early" class={pricingTier === 'early' ? 'active-tier-header' : (pricingTier !== 'early' ? 'completed-tier' : '')}>Miembro de la APP</th>
              <th data-tier="early" class={pricingTier === 'early' ? 'active-tier-header' : (pricingTier !== 'early' ? 'completed-tier' : '')}>Asistente general</th>
              <th data-tier="regular" class={pricingTier === 'regular' ? 'active-tier-header' : (pricingTier === 'onsite' ? 'completed-tier' : '')}>Miembro de la APP</th>
              <th data-tier="regular" class={pricingTier === 'regular' ? 'active-tier-header' : (pricingTier === 'onsite' ? 'completed-tier' : '')}>Asistente general</th>
              <th data-tier="onsite" class={pricingTier === 'onsite' ? 'active-tier-header' : ''}>Miembro de la APP</th>
              <th data-tier="onsite" class={pricingTier === 'onsite' ? 'active-tier-header' : ''}>Asistente general</th>
            </tr>
          </thead>
          <tbody>
            {pricing.map((plan) => (
              <tr>
                <td><strong>{plan.category}</strong></td>
                <td class={`price-val ${pricingTier === 'early' ? 'active-tier-cell' : (pricingTier !== 'early' ? 'completed-tier' : '')}`} data-tier="early">S/ {plan.prices.early.app}</td>
                <td class={`price-val ${pricingTier === 'early' ? 'active-tier-cell' : (pricingTier !== 'early' ? 'completed-tier' : '')}`} data-tier="early">S/ {plan.prices.early.noApp}</td>
                <td class={`price-val ${pricingTier === 'regular' ? 'active-tier-cell' : (pricingTier === 'onsite' ? 'completed-tier' : '')}`} data-tier="regular">S/ {plan.prices.regular.app}</td>
                <td class={`price-val ${pricingTier === 'regular' ? 'active-tier-cell' : (pricingTier === 'onsite' ? 'completed-tier' : '')}`} data-tier="regular">S/ {plan.prices.regular.noApp}</td>
                <td class={`price-val ${pricingTier === 'onsite' ? 'active-tier-cell' : ''}`} data-tier="onsite">S/ {plan.prices.onsite.app}</td>
                <td class={`price-val ${pricingTier === 'onsite' ? 'active-tier-cell' : ''}`} data-tier="onsite">S/ {plan.prices.onsite.noApp}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="discount-callout reveal">
        <div class="discount-callout__icon">👥</div>
        <div class="discount-callout__content">
          <h3>Inscripción Grupal</h3>
          <p>Obtén un <strong>20% de descuento</strong> adicional por grupos de <strong>3 personas o más</strong>. Para validar el descuento, se debe adjuntar el voucher con los nombres de todos los miembros del grupo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Curso Pre-Congreso Section -->
  <section class="section" style="background: var(--cream-warm);" id="curso-pre-congreso">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Capacitación Especial</span>
        <h2 class="section-title">Curso Intensivo Pre-Congreso</h2>
        <p class="section-subtitle">
          Aprovecha esta oportunidad única de capacitarte con un referente mundial en etología y ecología social de primates.
        </p>
      </div>

      <div class="course-box-wrapper reveal">
        <div class="course-detail-card card-glass">
          <div class="course-detail-card__header">
            <span class="badge-accent">📚 CURSO EXCLUSIVO</span>
            <h3>Métodos y Conceptos en el Estudio de Relaciones Sociales y Estructura Social en Primates</h3>
            <p class="course-teacher"><strong>Docente:</strong> Dr. Filippo Aureli (México / Universidad Veracruzana)</p>
          </div>
          
          <div class="course-detail-card__body">
            <div class="course-info-grid">
              <div class="course-info-item">
                <strong>📅 Fecha y Hora:</strong>
                <span>Miércoles 29 de julio de 2026<br />03:30 PM - 05:30 PM</span>
              </div>
              <div class="course-info-item">
                <strong>📍 Lugar:</strong>
                <span>Parque de las Leyendas</span>
              </div>
              <div class="course-info-item">
                <strong>🔥 Cupos:</strong>
                <span>Estrictamente limitados a 20 participantes</span>
              </div>
              <div class="course-info-item">
                <strong>💵 Inversión:</strong>
                <span>Gratuito para inscritos al congreso principal (requiere pre-registro y confirmación de vacante)</span>
              </div>
            </div>

            <div class="course-description-box">
              <h4>Descripción del Curso</h4>
              <p>
                Este curso intensivo proporcionará una visión teórica y metodológica avanzada sobre cómo analizar las relaciones sociales en grupos de primates. Se explorarán conceptos clave como resolución de conflictos, reciprocidad, dinámicas de fisión-fusión y redes de asociación social.
              </p>
            </div>
            
            <div class="course-cta-container">
              <div class="course-warning-alert">
                <span>⚠️</span>
                <p><strong>¡Atención!</strong> Debido al carácter interactivo y al aforo de la sala, los cupos son limitados y se asignarán por evaluación del perfil básico del solicitante y orden de envío.</p>
              </div>
              <a 
                href="https://docs.google.com/forms/d/e/1FAIpQLSdYmscc-GmWwvqwu4VX4rdwrXithNiC1fAwiHKVSEklP40hzw/viewform?usp=dialog" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn btn-primary btn-lg"
                style="box-shadow: 0 10px 25px rgba(217,157,85,0.25); display: inline-flex; align-items: center; gap: 0.5rem;"
              >
                📝 Formulario de Inscripción al Curso →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Payment Info -->
  <section class="section" id="pago">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Registro</span>
        <h2 class="section-title">Información de Pago</h2>
      </div>

      <div class="payment-grid">
        <!-- Bank Details Card -->
        <div class="payment-card">
          <div class="payment-card__header">
            <div class="payment-card__icon">🏦</div>
            <h3 class="payment-card__title">Datos Bancarios</h3>
          </div>
          <div class="payment-card__body">
            <ul class="bank-details">
              <li><span>Titular:</span> <strong>Estación Biológica Kawsay</strong></li>
              <li><span>RUC:</span> <strong>20607343609</strong></li>
              <li><span>Banco:</span> <strong>Banco Interbank</strong></li>
              <li><span>Tipo de cuenta:</span> <strong>Cuenta Corriente Soles</strong></li>
              <li><span>Cuenta:</span> <strong>335-3003392978</strong></li>
              <li><span>CCI:</span> <strong>003-335-003003392978-74</strong></li>
              <li><span>Plin:</span> <strong>966 381 468 — Estación Biológica Kawsay</strong></li>
            </ul>
            
            <div class="plin-qr-container">
              <p class="plin-qr-label">Escanea aquí para pagar con Plin:</p>
              <img src={`${base}images/qr-plin.png`} alt="QR Plin Estación Biológica Kawsay" class="plin-qr-img" />
            </div>
          </div>
        </div>

        <!-- Steps Card -->
        <div class="payment-card reveal reveal-delay-2">
          <div class="payment-card__header">
            <div class="payment-card__icon">📝</div>
            <h3 class="payment-card__title">Pasos para registrar tu pago</h3>
          </div>
          <div class="payment-card__body">
            <ol class="payment-steps">
              <li>
                <strong>Realiza la transferencia o depósito:</strong> 
                Guarda una imagen legible de tu comprobante (voucher) donde se vea claramente el monto, fecha y número de operación.
              </li>
              <li>
                <strong>Completa el formulario:</strong> 
                Ingresa tus datos en el enlace de registro de pago que encontrarás debajo.
              </li>
              <li>
                <strong>Ten tus datos a la mano:</strong> 
                Se solicitará tu número de DNI, Pasaporte o Carné de Extranjería.
              </li>
            </ol>
            
            <div class="invoice-info">
              <h4>¿Necesitas factura?</h4>
              <p>Si requieres factura institucional, deberás indicar el <strong>RUC (11 dígitos)</strong> y la <strong>Razón Social exacta</strong> en el formulario. De lo contrario, se emitirá boleta personal.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="reveal" style="text-align:center; margin-top:3rem;">
        <a href="https://forms.gle/nTKgiQEpBX1GJtc19" target="_blank" rel="noopener" class="btn btn-primary btn-lg" id="cta-registro-pago">
          📋 Registrar mi Pago ahora →
        </a>
      </div>
    </div>
  </section>


  <!-- Política de cancelación -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Términos y condiciones</span>
        <h2 class="section-title">Política de Cancelación</h2>
      </div>

      <div class="policy-table reveal">
        <table>
          <thead>
            <tr>
              <th>Fecha de cancelación</th>
              <th>Reembolso</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Más de 60 días antes del congreso</td><td class="policy-green">100% reembolso</td></tr>
            <tr><td>30–60 días antes</td><td class="policy-gold">75% reembolso</td></tr>
            <tr><td>15–29 días antes</td><td class="policy-warn">50% reembolso</td></tr>
            <tr><td>Menos de 15 días o no presentación</td><td class="policy-red">Sin reembolso</td></tr>
          </tbody>
        </table>
        <p class="policy-note">* Las cancelaciones deben notificarse por escrito al correo oficial del congreso. El nombre del inscrito puede transferirse a otro participante sin cargo adicional antes de la fecha límite de inscripción.</p>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* Early Bird Extension Banner */
  .early-bird-extension {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2rem 2.5rem;
    background: linear-gradient(135deg, rgba(201,168,76,0.18) 0%, rgba(26,115,76,0.12) 60%, rgba(201,168,76,0.1) 100%);
    border: 2px solid rgba(201,168,76,0.5);
    border-radius: var(--radius-xl);
    margin-bottom: 1.5rem;
    position: relative;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(201,168,76,0.15);
  }
  .early-bird-extension::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(201,168,76,0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  :global([data-theme="dark"]) .early-bird-extension {
    background: linear-gradient(135deg, rgba(201,168,76,0.12) 0%, rgba(26,58,46,0.5) 100%);
    border-color: rgba(201,168,76,0.4);
  }

  .extension-badge {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    background: linear-gradient(135deg, var(--gold), #e8a820);
    color: #1a1a0e;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.35rem 1rem;
    border-radius: 100px;
    letter-spacing: 0.08em;
    animation: pulseBadge 2.5s ease-in-out infinite;
    box-shadow: 0 4px 12px rgba(201,168,76,0.4);
  }
  @keyframes pulseBadge {
    0%, 100% { transform: scale(1); box-shadow: 0 4px 12px rgba(201,168,76,0.4); }
    50% { transform: scale(1.06); box-shadow: 0 6px 20px rgba(201,168,76,0.6); }
  }

  .extension-content { flex: 1; padding-right: 7rem; }

  .extension-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--forest-mid);
    margin-bottom: 0.6rem;
    line-height: 1.3;
  }
  :global([data-theme="dark"]) .extension-title { color: var(--forest-canopy); }

  .extension-subtitle {
    font-size: 0.95rem;
    color: var(--text-on-light);
    line-height: 1.65;
    margin-bottom: 1rem;
  }
  :global([data-theme="dark"]) .extension-subtitle { color: var(--text-on-dark); }
  .extension-subtitle strong { color: var(--gold); }

  .extension-countdown {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: var(--forest-leaf);
    font-weight: 600;
    padding: 0.65rem 1rem;
    background: rgba(26,115,76,0.08);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--forest-leaf);
  }
  .extension-icon { font-size: 1.3rem; }

  @media (max-width: 640px) {
    .early-bird-extension { flex-direction: column; padding: 2rem 1.5rem; }
    .extension-content { padding-right: 0; }
    .extension-badge { position: static; align-self: flex-start; margin-bottom: 0.5rem; }
  }

  .early-bird-alert {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: linear-gradient(135deg, rgba(201,168,76,0.1), rgba(232,201,126,0.07));
    border: 1.5px solid rgba(201,168,76,0.3);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    color: var(--text-on-light);
    margin-bottom: 2.5rem;
  }
  :global([data-theme="dark"]) .early-bird-alert { color: var(--text-on-dark); }
  .early-bird-alert__icon { font-size: 1.75rem; flex-shrink: 0; }
  .early-bird-alert strong { color: var(--gold); }

  /* Pricing */
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 768px) { .pricing-grid { grid-template-columns: repeat(3, 1fr); } }

  .pricing-card {
    position: relative;
    padding: 2rem;
    background: rgba(255,255,255,0.9);
    border-radius: var(--radius-lg);
    border: 1.5px solid rgba(217,157,85,0.15);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: all var(--transition-mid);
  }
  :global([data-theme="dark"]) .pricing-card {
    background: rgba(26,58,46,0.55);
    border-color: rgba(217,157,85,0.2);
  }
  .pricing-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }

  .pricing-card--featured {
    border-color: var(--forest-leaf);
    box-shadow: var(--shadow-md), 0 0 30px rgba(217,157,85,0.12);
  }

  .pricing-card__featured-badge {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--forest-leaf);
    color: #fff;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.3rem 1rem;
    border-radius: 100px;
    white-space: nowrap;
  }

  .pricing-card__category {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--forest-mid);
  }
  :global([data-theme="dark"]) .pricing-card__category { color: var(--forest-canopy); }
  .pricing-card__desc { font-size: 0.82rem; color: var(--text-muted); margin-top: 0.2rem; }

  .pricing-card__prices { display: flex; flex-direction: column; gap: 0.5rem; }
  .pricing-card__price { display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; }
  .pricing-card__price-label { font-family: var(--font-ui); font-size: 0.72rem; font-weight: 600; color: var(--text-muted); min-width: 70px; }
  .pricing-card__price-amount { font-family: var(--font-display); font-size: 1.3rem; font-weight: 700; color: var(--text-on-light); }
  :global([data-theme="dark"]) .pricing-card__price-amount { color: var(--text-on-dark); }
  .pricing-card__price--early .pricing-card__price-amount { color: var(--forest-leaf); font-size: 1.7rem; }
  .pricing-card__price-regular { font-size: 1rem; color: var(--text-muted); }
  .pricing-card__price-period { font-size: 0.7rem; color: var(--text-muted); }

  .pricing-card__includes {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px solid rgba(217,157,85,0.1);
    padding-top: 1rem;
  }
  .pricing-card__includes li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .pricing-card__includes svg { color: var(--forest-leaf); flex-shrink: 0; }

  /* Pricing Table */
  .pricing-table-wrapper {
    overflow-x: auto;
    background: rgba(255,255,255,0.9);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    margin-bottom: 2rem;
  }
  :global([data-theme="dark"]) .pricing-table-wrapper { background: rgba(26,58,46,0.5); }

  .pricing-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 800px;
  }
  .pricing-table th, .pricing-table td {
    padding: 1.25rem 1rem;
    text-align: center;
    border: 1px solid rgba(217,157,85,0.15);
    font-size: 0.9rem;
  }
  .pricing-table th {
    background: var(--forest-mid);
    color: #fff;
    font-family: var(--font-ui);
    font-weight: 600;
  }
  .pricing-table th small { font-weight: 400; opacity: 0.9; display: block; margin-top: 0.2rem; }
  .pricing-table td:first-child { text-align: left; background: rgba(217,157,85,0.05); width: 30%; }
  .price-val { font-family: var(--font-display); font-weight: 700; color: var(--text-on-light); }
  :global([data-theme="dark"]) .price-val { color: var(--text-on-dark); }
  .pricing-table tr:hover td { background: rgba(217,157,85,0.08); }

  /* Discount Callout */
  .discount-callout {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2rem;
    background: var(--forest-soft);
    border-radius: var(--radius-lg);
    border: 2px dashed var(--forest-leaf);
    margin-top: 3rem;
  }
  :global([data-theme="dark"]) .discount-callout { background: rgba(26,58,46,0.4); }
  .discount-callout__icon { font-size: 3rem; }
  .discount-callout__content { flex: 1; }
  .discount-callout__content h3 { font-family: var(--font-display); color: var(--forest-mid); margin-bottom: 0.5rem; }
  .discount-callout__content p { font-size: 1rem; color: var(--text-on-light); }
  @media (max-width: 768px) {
    .discount-callout { flex-direction: column; text-align: center; gap: 1rem; }
  }

  /* Payment Section */
  .payment-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }
  @media (min-width: 1024px) {
